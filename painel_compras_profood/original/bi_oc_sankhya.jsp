<script>
(function () {
  "use strict";

  /* Consultas geradas pelo build a partir de queries.sql: { ID: { sql, params, tipos } } */
  var Q = {"Q_DIAG":{"sql":"SELECT TO_NUMBER(?) AS NUMERO, TO_CHAR(TO_DATE(?, 'YYYY-MM-DD'), 'DD/MM/YYYY') AS DATA, 'TESTE' AS TEXTO FROM DUAL","params":["DIAG_NUM","DT_FIM"],"tipos":["I","S"]},"Q_PARAMS":{"sql":"SELECT P.CHAVE, P.VALOR FROM BI_PARAM_COMPRA P","params":[],"tipos":[]},"Q_EXEC":{"sql":"WITH prm AS (\n    SELECT\n        TO_NUMBER(?)          AS CODEMP,\n        TO_NUMBER(?) / 10000  AS DIAS_MES,\n        TO_NUMBER(?)          AS MARGEM,\n        TO_NUMBER(?)          AS COB_MAX,\n        TO_NUMBER(?) / 10000  AS SEG_FRAC,\n        TO_NUMBER(?)          AS COB_A,\n        TO_NUMBER(?)          AS COB_B,\n        TO_NUMBER(?)          AS COB_C,\n        TO_NUMBER(?)          AS LT_PADRAO,\n        TO_NUMBER(?)          AS MEDIA_MODO,\n        TO_NUMBER(?)          AS MESES_MEDIA,\n        TO_NUMBER(?)          AS DIVISOR_MEDIA,\n        TO_NUMBER(?)          AS INCLUI_MES_ATUAL\n    FROM DUAL\n), jan AS (\n    SELECT\n        CASE WHEN PR.INCLUI_MES_ATUAL = 1 THEN TRUNC(SYSDATE, 'MM')\n             ELSE ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -1) END AS FIM,\n        GREATEST(1, PR.MESES_MEDIA) AS NMESES\n    FROM prm PR\n),\njan2 AS (\n    SELECT JA.FIM, JA.NMESES, ADD_MONTHS(JA.FIM, 1 - JA.NMESES) AS INI FROM jan JA\n),\ncons_mes AS (\n    SELECT CM.CODPROD, CM.ANO_MES,\n           SUM(NVL(CM.QTD_VENDA, 0) + NVL(CM.QTD_PERDA, 0) - NVL(CM.QTD_DEVOLUCAO, 0)) AS QTD\n    FROM (SELECT\n    X.CODPROD                                                     AS CODPROD,\n    X.CODEMP                                                      AS CODEMP,\n    X.ANO_MES                                                     AS ANO_MES,\n    SUM(CASE WHEN X.PAPEL = 'CONSUMO'   THEN X.QTD_BASE ELSE 0 END) AS QTD_VENDA,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN X.QTD_BASE ELSE 0 END) AS QTD_DEVOLUCAO,\n    SUM(CASE WHEN X.PAPEL = 'PERDA'     THEN X.QTD_BASE ELSE 0 END) AS QTD_PERDA,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN -X.QTD_BASE ELSE X.QTD_BASE END) AS QTD_CONSUMO,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN -X.VLR ELSE X.VLR END)           AS VLR_CONSUMO,\n    SUM(CASE WHEN X.FATOR IS NULL THEN 1 ELSE 0 END)              AS ITENS_SEM_CONVERSAO\nFROM (\n    SELECT\n        I.CODPROD, C.CODEMP, TP.PAPEL,\n        TO_CHAR(C.DTNEG, 'YYYY-MM')                 AS ANO_MES,\n        NVL(I.QTDNEG, 0) * NVL(\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END, 1)                                  AS QTD_BASE,\n        NVL(I.VLRTOT, 0)                             AS VLR,\n        CASE WHEN I.CODVOL = P.CODVOL THEN 1\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n        END                                          AS FATOR\n    FROM TGFCAB C\n    JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL IN ('CONSUMO', 'DEVOLUCAO', 'PERDA')\n    JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n    JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n    LEFT JOIN (\n        SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n               COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n        FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n    ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n    WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -36)\n      AND C.STATUSNOTA = 'L'\n) X\nGROUP BY X.CODPROD, X.CODEMP, X.ANO_MES) CM\n    CROSS JOIN prm PR\n    CROSS JOIN jan2 J\n    WHERE CM.ANO_MES >= TO_CHAR(J.INI, 'YYYY-MM')\n      AND CM.ANO_MES <= TO_CHAR(J.FIM, 'YYYY-MM')\n      AND (PR.CODEMP = 0 OR CM.CODEMP = PR.CODEMP)\n    GROUP BY CM.CODPROD, CM.ANO_MES\n),\ndvs AS (\n    SELECT\n        CASE WHEN PR.DIVISOR_MEDIA > 0 THEN PR.DIVISOR_MEDIA\n             ELSE (SELECT GREATEST(1, COUNT(DISTINCT XM.ANO_MES)) FROM cons_mes XM) END AS DIVISOR,\n        CASE WHEN PR.DIVISOR_MEDIA > 0 THEN 'PARAMETRO' ELSE 'MESES_COM_DADOS' END AS ORIGEM_DIVISOR\n    FROM prm PR\n),\ncons AS (\n    SELECT CS.CODPROD,\n           SUM(CS.QTD) AS QTD_JANELA,\n           SUM(CASE WHEN CS.ANO_MES >= TO_CHAR(ADD_MONTHS(J.FIM, -2), 'YYYY-MM') THEN CS.QTD ELSE 0 END) AS QTD_3M,\n           SUM(CASE WHEN CS.ANO_MES >= TO_CHAR(ADD_MONTHS(J.FIM, -5), 'YYYY-MM') THEN CS.QTD ELSE 0 END) AS QTD_6M\n    FROM cons_mes CS\n    CROSS JOIN jan2 J\n    GROUP BY CS.CODPROD\n),\nest AS (\n    SELECT ES0.CODPROD, SUM(NVL(ES0.QTD_ESTOQUE, 0)) AS QTD\n    FROM (SELECT\n    E.CODPROD                         AS CODPROD,\n    E.CODEMP                          AS CODEMP,\n    SUM(NVL(E.ESTOQUE, 0))            AS QTD_ESTOQUE,\n    SUM(NVL(E.RESERVADO, 0))          AS QTD_RESERVADO,\n    SUM(NVL(E.WMSBLOQUEADO, 0))       AS QTD_BLOQUEADO\nFROM TGFEST E\nWHERE E.CODLOCAL NOT IN (1030000, 2030000)\nGROUP BY E.CODPROD, E.CODEMP) ES0\n    CROSS JOIN prm PR\n    WHERE (PR.CODEMP = 0 OR ES0.CODEMP = PR.CODEMP)\n    GROUP BY ES0.CODPROD\n),\nemp AS (\n    SELECT EM0.CODPROD, SUM(NVL(EM0.QTD_EMPENHADA, 0)) AS QTD\n    FROM (SELECT\n    X.CODPROD                                     AS CODPROD,\n    X.CODEMP                                      AS CODEMP,\n    SUM(X.QTD_ABERTA * NVL(X.FATOR, 1))           AS QTD_EMPENHADA,\n    SUM(X.QTD_ABERTA * X.VLRUNIT)                 AS VLR_EMPENHADO,\n    SUM(CASE WHEN X.FATOR IS NULL THEN 1 ELSE 0 END) AS ITENS_SEM_CONVERSAO\nFROM (\n    SELECT\n        I.CODPROD, C.CODEMP, NVL(I.VLRUNIT, 0) AS VLRUNIT,\n        GREATEST(NVL(I.QTDNEG, 0) - NVL(I.QTDENTREGUE, 0) - NVL(I.QTDCONFERIDA, 0), 0) AS QTD_ABERTA,\n        CASE WHEN I.CODVOL = P.CODVOL THEN 1\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n        END AS FATOR\n    FROM TGFCAB C\n    JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'EMPENHO'\n    JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n    JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n    LEFT JOIN (\n        SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n               COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n        FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n    ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n    WHERE I.PENDENTE = 'S'\n      AND NVL(I.CANCELADO, 'N') <> 'S'\n) X\nWHERE X.QTD_ABERTA > 0\nGROUP BY X.CODPROD, X.CODEMP) EM0\n    CROSS JOIN prm PR\n    WHERE (PR.CODEMP = 0 OR EM0.CODEMP = PR.CODEMP)\n    GROUP BY EM0.CODPROD\n),\nocx AS (\n    SELECT OX.CODPROD, OX.NUNOTA, OX.SEQUENCIA, OX.CODEMP, OX.STATUS_OC, OX.QTD_PENDENTE,\n           OX.VLR_UNIT, OX.DT_NEGOCIACAO\n    FROM (SELECT\n    Z.NUNOTA, Z.SEQUENCIA, Z.CODEMP, Z.CODPARC, Z.FORNECEDOR, Z.CODTIPOPER, Z.DESCRICAO_TOP,\n    Z.CODPROD, Z.OS,\n    Z.QTDNEG * NVL(Z.FATOR, 1)                                       AS QTD_NEGOCIADA,\n    Z.QTDENTREGUE * NVL(Z.FATOR, 1)                                  AS QTD_ENTREGUE,\n    CASE WHEN Z.ABERTA = 1 THEN (Z.QTDNEG - Z.QTDENTREGUE) * NVL(Z.FATOR, 1) ELSE 0 END AS QTD_PENDENTE,\n    CASE WHEN Z.QTDNEG * NVL(Z.FATOR, 1) > 0 THEN Z.VLRTOT / (Z.QTDNEG * NVL(Z.FATOR, 1)) ELSE 0 END AS VLR_UNIT,\n    Z.VLRTOT                                                         AS VLR_TOTAL,\n    Z.DT_NEGOCIACAO,\n    Z.DT_ENTREGA_PREVISTA,\n    Z.PREVISAO_ORIGEM,\n    NVL(Z.DT_LIBERACAO, CASE WHEN Z.STATUSNOTA = 'L' THEN Z.DT_NEGOCIACAO END) AS DT_APROVACAO,\n    Z.DT_ENTREGA_REAL,\n    CASE WHEN Z.CANCELADO = 'S'                              THEN 'CANCELADA'\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG     THEN 'ENTREGUE'\n         WHEN Z.PENDENTE = 'N' AND Z.QTDENTREGUE > 0         THEN 'ENCERRADA_PARCIAL'\n         WHEN Z.PENDENTE = 'N'                               THEN 'ENCERRADA_SEM_RECEBER'\n         WHEN Z.QTDENTREGUE > 0                              THEN 'ENTREGA_PARCIAL'\n         WHEN Z.STATUSNOTA = 'L'                             THEN 'APROVADA_NAO_ENTREGUE'\n         ELSE 'ABERTA_NAO_APROVADA'\n    END                                                              AS STATUS_OC,\n    CASE WHEN Z.ABERTA = 1 AND Z.DT_ENTREGA_PREVISTA < TRUNC(SYSDATE)\n              THEN TRUNC(SYSDATE) - Z.DT_ENTREGA_PREVISTA\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG\n              AND Z.DT_ENTREGA_REAL IS NOT NULL AND Z.DT_ENTREGA_PREVISTA IS NOT NULL\n              THEN Z.DT_ENTREGA_REAL - Z.DT_ENTREGA_PREVISTA\n         ELSE 0\n    END                                                              AS DIAS_ATRASO,\n    CASE WHEN Z.FATOR IS NULL THEN 1 ELSE 0 END                      AS FL_SEM_CONVERSAO\nFROM (\n    SELECT Y.*,\n        CASE WHEN Y.CANCELADO <> 'S' AND Y.PENDENTE = 'S' AND Y.QTDENTREGUE < Y.QTDNEG THEN 1 ELSE 0 END AS ABERTA,\n        CASE WHEN Y.QTDENTREGUE > 0 THEN COALESCE(\n            (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFVAR V JOIN TGFCAB N ON N.NUNOTA = V.NUNOTA\n              WHERE V.NUNOTAORIG = Y.NUNOTA AND V.SEQUENCIAORIG = Y.SEQUENCIA AND V.NUNOTA <> Y.NUNOTA),\n            CASE WHEN Y.OS IS NOT NULL THEN\n                (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFITE E JOIN TGFCAB N ON N.NUNOTA = E.NUNOTA\n                  WHERE N.CODTIPOPER IN (259, 200) AND N.STATUSNOTA = 'L'\n                    AND TRIM(E.AD_OS) = Y.OS AND E.CODPROD = Y.CODPROD\n                    AND N.DTNEG >= Y.DT_NEGOCIACAO - 365)\n            END)\n        END AS DT_ENTREGA_REAL\n    FROM (\n        SELECT\n            C.NUNOTA, I.SEQUENCIA, C.CODEMP, C.CODPARC, PA.NOMEPARC AS FORNECEDOR,\n            C.CODTIPOPER, T.DESCROPER AS DESCRICAO_TOP, I.CODPROD,\n            TRIM(C.AD_OSTUICIAL)                     AS OS,\n            C.STATUSNOTA, NVL(I.PENDENTE, 'S')       AS PENDENTE, NVL(I.CANCELADO, 'N') AS CANCELADO,\n            NVL(I.QTDNEG, 0)                         AS QTDNEG,\n            NVL(I.QTDENTREGUE, 0)                    AS QTDENTREGUE,\n            NVL(I.VLRTOT, 0)                         AS VLRTOT,\n            TRUNC(C.DTNEG)                           AS DT_NEGOCIACAO,\n            COALESCE(TRUNC(C.DTPREVENT), TRUNC(C.DTNEG) + CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END) AS DT_ENTREGA_PREVISTA,\n            CASE WHEN C.DTPREVENT IS NOT NULL THEN 'DTPREVENT'\n                 WHEN P.LEADTIME > 0 THEN 'OC+LEADTIME' END AS PREVISAO_ORIGEM,\n            (SELECT TRUNC(MAX(L.DHLIB)) FROM TSILIB L\n              WHERE L.TABELA = 'TGFCAB' AND L.NUCHAVE = C.NUNOTA\n                AND L.DHLIB IS NOT NULL AND NVL(L.REPROVADO, 'N') <> 'S') AS DT_LIBERACAO,\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END                                      AS FATOR\n        FROM TGFCAB C\n        JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'ORDEM_COMPRA'\n        JOIN TGFTOP T ON T.CODTIPOPER = C.CODTIPOPER AND T.DHALTER = C.DHTIPOPER\n        JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n        JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n        LEFT JOIN TGFPAR PA ON PA.CODPARC = C.CODPARC\n        LEFT JOIN (\n            SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n                   COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n            FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n        ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n        WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -24)\n    ) Y\n) Z) OX\n),\nocab AS (\n    SELECT OA0.CODPROD, SUM(OA0.QTD_PENDENTE) AS QTD, COUNT(DISTINCT OA0.NUNOTA) AS N_OCS\n    FROM ocx OA0\n    CROSS JOIN prm PR\n    WHERE OA0.STATUS_OC IN ('ABERTA_NAO_APROVADA', 'APROVADA_NAO_ENTREGUE', 'ENTREGA_PARCIAL')\n      AND OA0.QTD_PENDENTE > 0\n      AND (PR.CODEMP = 0 OR OA0.CODEMP = PR.CODEMP)\n    GROUP BY OA0.CODPROD\n),\ncusto AS (\n    SELECT CU0.CODPROD, CU0.VLR_UNIT\n    FROM (\n        SELECT CX.CODPROD, CX.VLR_UNIT,\n               ROW_NUMBER() OVER (PARTITION BY CX.CODPROD\n                                  ORDER BY CX.DT_NEGOCIACAO DESC, CX.NUNOTA DESC, CX.SEQUENCIA DESC) AS RN\n        FROM ocx CX\n        WHERE CX.VLR_UNIT > 0 AND CX.STATUS_OC <> 'CANCELADA'\n    ) CU0\n    WHERE CU0.RN = 1\n),\nbase AS (\n    SELECT\n        PD.CODPROD, PD.DESCRPROD, PD.UNIDADE, PD.GRUPO, PD.GRUPO_DESCR, PD.CURVA_ABC,\n        PD.MULTIPLO_COMPRA, PD.LOTE_MINIMO, PD.ESTOQUE_MIN_PARAM,\n        NVL(PD.FL_SOB_ENCOMENDA, 0) AS FL_SOB_ENCOMENDA,\n        NVL(PD.FL_CONSIGNADO, 0) AS FL_CONSIGNADO,\n        NVL(ES.QTD, 0) AS QTD_ESTOQUE,\n        NVL(EM.QTD, 0) AS QTD_EMPENHADA,\n        NVL(ES.QTD, 0) - NVL(EM.QTD, 0) AS QTD_DISPONIVEL,\n        NVL(OA.QTD, 0) AS QTD_PENDENTE,\n        NVL(OA.N_OCS, 0) AS N_OCS_ABERTAS,\n        NVL(CU.VLR_UNIT, 0) AS VLR_UNIT,\n        CASE WHEN PD.LEADTIME_PARAM_DIAS > 0 THEN PD.LEADTIME_PARAM_DIAS ELSE PR.LT_PADRAO END AS LEADTIME,\n        CASE WHEN PD.LEADTIME_PARAM_DIAS > 0 THEN 0 ELSE 1 END AS FL_LT_PADRAO,\n        NVL(CO.QTD_JANELA, 0) AS QTD_JANELA,\n        NVL(CO.QTD_3M, 0) AS QTD_3M,\n        GREATEST(0, NVL(CO.QTD_JANELA, 0) / DV.DIVISOR) AS MEDIA_SIMPLES,\n        GREATEST(0, 0.5 * NVL(CO.QTD_3M, 0) / 3 + 0.3 * NVL(CO.QTD_6M, 0) / 6\n                    + 0.2 * NVL(CO.QTD_JANELA, 0) / DV.DIVISOR) AS MEDIA_PONDERADA,\n        CASE UPPER(NVL(PD.CURVA_ABC, 'C')) WHEN 'A' THEN PR.COB_A WHEN 'B' THEN PR.COB_B ELSE PR.COB_C END AS COB_ALVO,\n        PR.MEDIA_MODO, PR.DIAS_MES, PR.MARGEM, PR.COB_MAX, PR.SEG_FRAC\n    FROM (SELECT\n    P.CODPROD                                                AS CODPROD,\n    P.DESCRPROD                                              AS DESCRPROD,\n    P.REFERENCIA                                             AS REFERENCIA,\n    P.CODVOL                                                 AS UNIDADE,\n    P.MARCA                                                  AS MARCA,\n    P.CODGRUPOPROD                                           AS GRUPO,\n    G.DESCRGRUPOPROD                                         AS GRUPO_DESCR,\n    CASE WHEN P.ATIVO = 'S' THEN 1 ELSE 0 END                AS FL_ATIVO,\n    CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END             AS LEADTIME_PARAM_DIAS,\n    CASE WHEN P.ESTMIN > 0 THEN P.ESTMIN END                 AS ESTOQUE_MIN_PARAM,\n    CAST(NULL AS VARCHAR2(1))                                AS CURVA_ABC,\n    CASE WHEN P.AGRUPMIN > 1 THEN P.AGRUPMIN END             AS MULTIPLO_COMPRA,\n    CASE WHEN P.LOTECOMPMINIMO > 0 THEN P.LOTECOMPMINIMO END AS LOTE_MINIMO,\n    0                                                        AS FL_SOB_ENCOMENDA,\n    CASE WHEN NVL(P.CODPARCCONSIG, 0) > 0 THEN 1 ELSE 0 END  AS FL_CONSIGNADO\nFROM TGFPRO P\nLEFT JOIN TGFGRU G ON G.CODGRUPOPROD = P.CODGRUPOPROD) PD\n    CROSS JOIN prm PR\n    CROSS JOIN dvs DV\n    LEFT JOIN est ES ON ES.CODPROD = PD.CODPROD\n    LEFT JOIN emp EM ON EM.CODPROD = PD.CODPROD\n    LEFT JOIN ocab OA ON OA.CODPROD = PD.CODPROD\n    LEFT JOIN custo CU ON CU.CODPROD = PD.CODPROD\n    LEFT JOIN cons CO ON CO.CODPROD = PD.CODPROD\n    WHERE PD.FL_ATIVO = 1\n),\nmed AS (\n    SELECT BA.*,\n           CASE WHEN BA.MEDIA_MODO = 1 THEN BA.MEDIA_PONDERADA ELSE BA.MEDIA_SIMPLES END AS MEDIA_USADA\n    FROM base BA\n),\ndem AS (\n    SELECT ME.*, ME.MEDIA_USADA / ME.DIAS_MES AS DEMANDA_DIARIA FROM med ME\n),\ncob AS (\n    SELECT DE.*,\n        CASE WHEN DE.DEMANDA_DIARIA > 0 THEN DE.QTD_DISPONIVEL / DE.DEMANDA_DIARIA ELSE 999 END AS DIAS_EST_ATUAL,\n        CASE WHEN DE.DEMANDA_DIARIA > 0 THEN (DE.QTD_DISPONIVEL + DE.QTD_PENDENTE) / DE.DEMANDA_DIARIA ELSE 999 END AS DIAS_EST,\n        DE.DEMANDA_DIARIA * DE.LEADTIME * (1 + DE.SEG_FRAC) AS EST_MIN_CALC,\n        CASE WHEN DE.QTD_DISPONIVEL < 0 THEN -DE.QTD_DISPONIVEL * DE.VLR_UNIT ELSE 0 END AS RUPTURA_VALOR,\n        CASE WHEN DE.FL_SOB_ENCOMENDA = 1 OR DE.FL_CONSIGNADO = 1 OR DE.QTD_JANELA <= 0 THEN 0\n             ELSE GREATEST(0, DE.DEMANDA_DIARIA * (DE.LEADTIME + DE.COB_ALVO)\n                              - (DE.QTD_DISPONIVEL + DE.QTD_PENDENTE)) END AS QTD_BRUTA\n    FROM dem DE\n),\nmult AS (\n    SELECT CB.*,\n        CASE WHEN CB.QTD_BRUTA <= 0 THEN 0\n             WHEN NVL(CB.MULTIPLO_COMPRA, 0) > 0 THEN CEIL(CB.QTD_BRUTA / CB.MULTIPLO_COMPRA) * CB.MULTIPLO_COMPRA\n             ELSE CEIL(CB.QTD_BRUTA) END AS QTD_MULT\n    FROM cob CB\n),\nsop AS (\n    SELECT MU.*,\n        CASE WHEN MU.QTD_MULT > 0 AND NVL(MU.LOTE_MINIMO, 0) > MU.QTD_MULT\n             THEN CASE WHEN NVL(MU.MULTIPLO_COMPRA, 0) > 0\n                       THEN CEIL(MU.LOTE_MINIMO / MU.MULTIPLO_COMPRA) * MU.MULTIPLO_COMPRA\n                       ELSE MU.LOTE_MINIMO END\n             ELSE MU.QTD_MULT END AS QTD_SUGERIDA,\n        CASE WHEN MU.QTD_DISPONIVEL < 0 OR (MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST <= 0) THEN 'P1_CRITICO'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME               THEN 'P2_RUPTURA_IMINENTE'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME + MU.MARGEM   THEN 'P3_ATENCAO'\n             WHEN MU.QTD_ESTOQUE > 0 AND MU.QTD_JANELA <= 0                         THEN 'P0_EXCESSO_SEM_GIRO'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST > MU.COB_MAX                THEN 'P0_EXCESSO'\n             ELSE 'OK' END AS PRIORIDADE,\n        CASE WHEN MU.QTD_DISPONIVEL < 0                                             THEN 'RUPTURA'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME               THEN 'PONTO_PEDIDO'\n             WHEN MU.ESTOQUE_MIN_PARAM > 0 AND MU.QTD_DISPONIVEL < MU.ESTOQUE_MIN_PARAM THEN 'MINIMO_CURVA_A'\n             ELSE 'SEM_DISPARO' END AS REGRA_DISPARO\n    FROM mult MU\n)\nSELECT S.PRIORIDADE,\n       COUNT(*)                                                        AS N_SKUS,\n       ROUND(SUM(S.RUPTURA_VALOR), 2)                                  AS RUPTURA,\n       SUM(CASE WHEN S.RUPTURA_VALOR > 0 THEN 1 ELSE 0 END)            AS N_RUPTURA,\n       SUM(CASE WHEN S.QTD_SUGERIDA > 0 THEN 1 ELSE 0 END)             AS N_SUGERIDOS,\n       ROUND(SUM(S.QTD_SUGERIDA * S.VLR_UNIT), 2)                      AS NECESSIDADE,\n       SUM(CASE WHEN S.QTD_SUGERIDA > 0 AND S.VLR_UNIT = 0 THEN 1 ELSE 0 END) AS N_SEM_CUSTO,\n       SUM(S.FL_LT_PADRAO)                                             AS N_LT_PADRAO,\n       MAX(DV.DIVISOR)                                                 AS DIVISOR,\n       MAX(DV.ORIGEM_DIVISOR)                                          AS ORIGEM_DIVISOR,\n       MAX(TO_CHAR(J.INI, 'MM/YYYY'))                                  AS JANELA_INI,\n       MAX(TO_CHAR(J.FIM, 'MM/YYYY'))                                  AS JANELA_FIM,\n       MAX(TO_CHAR(SYSDATE, 'DD/MM/YYYY HH24:MI'))                     AS SNAPSHOT\nFROM sop S\nCROSS JOIN dvs DV\nCROSS JOIN jan2 J\nGROUP BY S.PRIORIDADE","params":["CODEMP","DIAS_MES_X10000","MARGEM_ATENCAO_DIAS","COBERTURA_MAX_DIAS","SEGURANCA_X10000","COBERTURA_ALVO_A","COBERTURA_ALVO_B","COBERTURA_ALVO_C","LEADTIME_DEFAULT","MEDIA_MODO","MESES_MEDIA","DIVISOR_MEDIA","INCLUI_MES_ATUAL"],"tipos":["I","I","I","I","I","I","I","I","I","I","I","I","I"]},"Q_TOP15":{"sql":"WITH prm AS (\n    SELECT\n        TO_NUMBER(?)          AS CODEMP,\n        TO_NUMBER(?) / 10000  AS DIAS_MES,\n        TO_NUMBER(?)          AS MARGEM,\n        TO_NUMBER(?)          AS COB_MAX,\n        TO_NUMBER(?) / 10000  AS SEG_FRAC,\n        TO_NUMBER(?)          AS COB_A,\n        TO_NUMBER(?)          AS COB_B,\n        TO_NUMBER(?)          AS COB_C,\n        TO_NUMBER(?)          AS LT_PADRAO,\n        TO_NUMBER(?)          AS MEDIA_MODO,\n        TO_NUMBER(?)          AS MESES_MEDIA,\n        TO_NUMBER(?)          AS DIVISOR_MEDIA,\n        TO_NUMBER(?)          AS INCLUI_MES_ATUAL\n    FROM DUAL\n), jan AS (\n    SELECT\n        CASE WHEN PR.INCLUI_MES_ATUAL = 1 THEN TRUNC(SYSDATE, 'MM')\n             ELSE ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -1) END AS FIM,\n        GREATEST(1, PR.MESES_MEDIA) AS NMESES\n    FROM prm PR\n),\njan2 AS (\n    SELECT JA.FIM, JA.NMESES, ADD_MONTHS(JA.FIM, 1 - JA.NMESES) AS INI FROM jan JA\n),\ncons_mes AS (\n    SELECT CM.CODPROD, CM.ANO_MES,\n           SUM(NVL(CM.QTD_VENDA, 0) + NVL(CM.QTD_PERDA, 0) - NVL(CM.QTD_DEVOLUCAO, 0)) AS QTD\n    FROM (SELECT\n    X.CODPROD                                                     AS CODPROD,\n    X.CODEMP                                                      AS CODEMP,\n    X.ANO_MES                                                     AS ANO_MES,\n    SUM(CASE WHEN X.PAPEL = 'CONSUMO'   THEN X.QTD_BASE ELSE 0 END) AS QTD_VENDA,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN X.QTD_BASE ELSE 0 END) AS QTD_DEVOLUCAO,\n    SUM(CASE WHEN X.PAPEL = 'PERDA'     THEN X.QTD_BASE ELSE 0 END) AS QTD_PERDA,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN -X.QTD_BASE ELSE X.QTD_BASE END) AS QTD_CONSUMO,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN -X.VLR ELSE X.VLR END)           AS VLR_CONSUMO,\n    SUM(CASE WHEN X.FATOR IS NULL THEN 1 ELSE 0 END)              AS ITENS_SEM_CONVERSAO\nFROM (\n    SELECT\n        I.CODPROD, C.CODEMP, TP.PAPEL,\n        TO_CHAR(C.DTNEG, 'YYYY-MM')                 AS ANO_MES,\n        NVL(I.QTDNEG, 0) * NVL(\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END, 1)                                  AS QTD_BASE,\n        NVL(I.VLRTOT, 0)                             AS VLR,\n        CASE WHEN I.CODVOL = P.CODVOL THEN 1\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n        END                                          AS FATOR\n    FROM TGFCAB C\n    JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL IN ('CONSUMO', 'DEVOLUCAO', 'PERDA')\n    JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n    JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n    LEFT JOIN (\n        SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n               COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n        FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n    ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n    WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -36)\n      AND C.STATUSNOTA = 'L'\n) X\nGROUP BY X.CODPROD, X.CODEMP, X.ANO_MES) CM\n    CROSS JOIN prm PR\n    CROSS JOIN jan2 J\n    WHERE CM.ANO_MES >= TO_CHAR(J.INI, 'YYYY-MM')\n      AND CM.ANO_MES <= TO_CHAR(J.FIM, 'YYYY-MM')\n      AND (PR.CODEMP = 0 OR CM.CODEMP = PR.CODEMP)\n    GROUP BY CM.CODPROD, CM.ANO_MES\n),\ndvs AS (\n    SELECT\n        CASE WHEN PR.DIVISOR_MEDIA > 0 THEN PR.DIVISOR_MEDIA\n             ELSE (SELECT GREATEST(1, COUNT(DISTINCT XM.ANO_MES)) FROM cons_mes XM) END AS DIVISOR,\n        CASE WHEN PR.DIVISOR_MEDIA > 0 THEN 'PARAMETRO' ELSE 'MESES_COM_DADOS' END AS ORIGEM_DIVISOR\n    FROM prm PR\n),\ncons AS (\n    SELECT CS.CODPROD,\n           SUM(CS.QTD) AS QTD_JANELA,\n           SUM(CASE WHEN CS.ANO_MES >= TO_CHAR(ADD_MONTHS(J.FIM, -2), 'YYYY-MM') THEN CS.QTD ELSE 0 END) AS QTD_3M,\n           SUM(CASE WHEN CS.ANO_MES >= TO_CHAR(ADD_MONTHS(J.FIM, -5), 'YYYY-MM') THEN CS.QTD ELSE 0 END) AS QTD_6M\n    FROM cons_mes CS\n    CROSS JOIN jan2 J\n    GROUP BY CS.CODPROD\n),\nest AS (\n    SELECT ES0.CODPROD, SUM(NVL(ES0.QTD_ESTOQUE, 0)) AS QTD\n    FROM (SELECT\n    E.CODPROD                         AS CODPROD,\n    E.CODEMP                          AS CODEMP,\n    SUM(NVL(E.ESTOQUE, 0))            AS QTD_ESTOQUE,\n    SUM(NVL(E.RESERVADO, 0))          AS QTD_RESERVADO,\n    SUM(NVL(E.WMSBLOQUEADO, 0))       AS QTD_BLOQUEADO\nFROM TGFEST E\nWHERE E.CODLOCAL NOT IN (1030000, 2030000)\nGROUP BY E.CODPROD, E.CODEMP) ES0\n    CROSS JOIN prm PR\n    WHERE (PR.CODEMP = 0 OR ES0.CODEMP = PR.CODEMP)\n    GROUP BY ES0.CODPROD\n),\nemp AS (\n    SELECT EM0.CODPROD, SUM(NVL(EM0.QTD_EMPENHADA, 0)) AS QTD\n    FROM (SELECT\n    X.CODPROD                                     AS CODPROD,\n    X.CODEMP                                      AS CODEMP,\n    SUM(X.QTD_ABERTA * NVL(X.FATOR, 1))           AS QTD_EMPENHADA,\n    SUM(X.QTD_ABERTA * X.VLRUNIT)                 AS VLR_EMPENHADO,\n    SUM(CASE WHEN X.FATOR IS NULL THEN 1 ELSE 0 END) AS ITENS_SEM_CONVERSAO\nFROM (\n    SELECT\n        I.CODPROD, C.CODEMP, NVL(I.VLRUNIT, 0) AS VLRUNIT,\n        GREATEST(NVL(I.QTDNEG, 0) - NVL(I.QTDENTREGUE, 0) - NVL(I.QTDCONFERIDA, 0), 0) AS QTD_ABERTA,\n        CASE WHEN I.CODVOL = P.CODVOL THEN 1\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n        END AS FATOR\n    FROM TGFCAB C\n    JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'EMPENHO'\n    JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n    JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n    LEFT JOIN (\n        SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n               COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n        FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n    ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n    WHERE I.PENDENTE = 'S'\n      AND NVL(I.CANCELADO, 'N') <> 'S'\n) X\nWHERE X.QTD_ABERTA > 0\nGROUP BY X.CODPROD, X.CODEMP) EM0\n    CROSS JOIN prm PR\n    WHERE (PR.CODEMP = 0 OR EM0.CODEMP = PR.CODEMP)\n    GROUP BY EM0.CODPROD\n),\nocx AS (\n    SELECT OX.CODPROD, OX.NUNOTA, OX.SEQUENCIA, OX.CODEMP, OX.STATUS_OC, OX.QTD_PENDENTE,\n           OX.VLR_UNIT, OX.DT_NEGOCIACAO\n    FROM (SELECT\n    Z.NUNOTA, Z.SEQUENCIA, Z.CODEMP, Z.CODPARC, Z.FORNECEDOR, Z.CODTIPOPER, Z.DESCRICAO_TOP,\n    Z.CODPROD, Z.OS,\n    Z.QTDNEG * NVL(Z.FATOR, 1)                                       AS QTD_NEGOCIADA,\n    Z.QTDENTREGUE * NVL(Z.FATOR, 1)                                  AS QTD_ENTREGUE,\n    CASE WHEN Z.ABERTA = 1 THEN (Z.QTDNEG - Z.QTDENTREGUE) * NVL(Z.FATOR, 1) ELSE 0 END AS QTD_PENDENTE,\n    CASE WHEN Z.QTDNEG * NVL(Z.FATOR, 1) > 0 THEN Z.VLRTOT / (Z.QTDNEG * NVL(Z.FATOR, 1)) ELSE 0 END AS VLR_UNIT,\n    Z.VLRTOT                                                         AS VLR_TOTAL,\n    Z.DT_NEGOCIACAO,\n    Z.DT_ENTREGA_PREVISTA,\n    Z.PREVISAO_ORIGEM,\n    NVL(Z.DT_LIBERACAO, CASE WHEN Z.STATUSNOTA = 'L' THEN Z.DT_NEGOCIACAO END) AS DT_APROVACAO,\n    Z.DT_ENTREGA_REAL,\n    CASE WHEN Z.CANCELADO = 'S'                              THEN 'CANCELADA'\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG     THEN 'ENTREGUE'\n         WHEN Z.PENDENTE = 'N' AND Z.QTDENTREGUE > 0         THEN 'ENCERRADA_PARCIAL'\n         WHEN Z.PENDENTE = 'N'                               THEN 'ENCERRADA_SEM_RECEBER'\n         WHEN Z.QTDENTREGUE > 0                              THEN 'ENTREGA_PARCIAL'\n         WHEN Z.STATUSNOTA = 'L'                             THEN 'APROVADA_NAO_ENTREGUE'\n         ELSE 'ABERTA_NAO_APROVADA'\n    END                                                              AS STATUS_OC,\n    CASE WHEN Z.ABERTA = 1 AND Z.DT_ENTREGA_PREVISTA < TRUNC(SYSDATE)\n              THEN TRUNC(SYSDATE) - Z.DT_ENTREGA_PREVISTA\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG\n              AND Z.DT_ENTREGA_REAL IS NOT NULL AND Z.DT_ENTREGA_PREVISTA IS NOT NULL\n              THEN Z.DT_ENTREGA_REAL - Z.DT_ENTREGA_PREVISTA\n         ELSE 0\n    END                                                              AS DIAS_ATRASO,\n    CASE WHEN Z.FATOR IS NULL THEN 1 ELSE 0 END                      AS FL_SEM_CONVERSAO\nFROM (\n    SELECT Y.*,\n        CASE WHEN Y.CANCELADO <> 'S' AND Y.PENDENTE = 'S' AND Y.QTDENTREGUE < Y.QTDNEG THEN 1 ELSE 0 END AS ABERTA,\n        CASE WHEN Y.QTDENTREGUE > 0 THEN COALESCE(\n            (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFVAR V JOIN TGFCAB N ON N.NUNOTA = V.NUNOTA\n              WHERE V.NUNOTAORIG = Y.NUNOTA AND V.SEQUENCIAORIG = Y.SEQUENCIA AND V.NUNOTA <> Y.NUNOTA),\n            CASE WHEN Y.OS IS NOT NULL THEN\n                (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFITE E JOIN TGFCAB N ON N.NUNOTA = E.NUNOTA\n                  WHERE N.CODTIPOPER IN (259, 200) AND N.STATUSNOTA = 'L'\n                    AND TRIM(E.AD_OS) = Y.OS AND E.CODPROD = Y.CODPROD\n                    AND N.DTNEG >= Y.DT_NEGOCIACAO - 365)\n            END)\n        END AS DT_ENTREGA_REAL\n    FROM (\n        SELECT\n            C.NUNOTA, I.SEQUENCIA, C.CODEMP, C.CODPARC, PA.NOMEPARC AS FORNECEDOR,\n            C.CODTIPOPER, T.DESCROPER AS DESCRICAO_TOP, I.CODPROD,\n            TRIM(C.AD_OSTUICIAL)                     AS OS,\n            C.STATUSNOTA, NVL(I.PENDENTE, 'S')       AS PENDENTE, NVL(I.CANCELADO, 'N') AS CANCELADO,\n            NVL(I.QTDNEG, 0)                         AS QTDNEG,\n            NVL(I.QTDENTREGUE, 0)                    AS QTDENTREGUE,\n            NVL(I.VLRTOT, 0)                         AS VLRTOT,\n            TRUNC(C.DTNEG)                           AS DT_NEGOCIACAO,\n            COALESCE(TRUNC(C.DTPREVENT), TRUNC(C.DTNEG) + CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END) AS DT_ENTREGA_PREVISTA,\n            CASE WHEN C.DTPREVENT IS NOT NULL THEN 'DTPREVENT'\n                 WHEN P.LEADTIME > 0 THEN 'OC+LEADTIME' END AS PREVISAO_ORIGEM,\n            (SELECT TRUNC(MAX(L.DHLIB)) FROM TSILIB L\n              WHERE L.TABELA = 'TGFCAB' AND L.NUCHAVE = C.NUNOTA\n                AND L.DHLIB IS NOT NULL AND NVL(L.REPROVADO, 'N') <> 'S') AS DT_LIBERACAO,\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END                                      AS FATOR\n        FROM TGFCAB C\n        JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'ORDEM_COMPRA'\n        JOIN TGFTOP T ON T.CODTIPOPER = C.CODTIPOPER AND T.DHALTER = C.DHTIPOPER\n        JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n        JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n        LEFT JOIN TGFPAR PA ON PA.CODPARC = C.CODPARC\n        LEFT JOIN (\n            SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n                   COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n            FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n        ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n        WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -24)\n    ) Y\n) Z) OX\n),\nocab AS (\n    SELECT OA0.CODPROD, SUM(OA0.QTD_PENDENTE) AS QTD, COUNT(DISTINCT OA0.NUNOTA) AS N_OCS\n    FROM ocx OA0\n    CROSS JOIN prm PR\n    WHERE OA0.STATUS_OC IN ('ABERTA_NAO_APROVADA', 'APROVADA_NAO_ENTREGUE', 'ENTREGA_PARCIAL')\n      AND OA0.QTD_PENDENTE > 0\n      AND (PR.CODEMP = 0 OR OA0.CODEMP = PR.CODEMP)\n    GROUP BY OA0.CODPROD\n),\ncusto AS (\n    SELECT CU0.CODPROD, CU0.VLR_UNIT\n    FROM (\n        SELECT CX.CODPROD, CX.VLR_UNIT,\n               ROW_NUMBER() OVER (PARTITION BY CX.CODPROD\n                                  ORDER BY CX.DT_NEGOCIACAO DESC, CX.NUNOTA DESC, CX.SEQUENCIA DESC) AS RN\n        FROM ocx CX\n        WHERE CX.VLR_UNIT > 0 AND CX.STATUS_OC <> 'CANCELADA'\n    ) CU0\n    WHERE CU0.RN = 1\n),\nbase AS (\n    SELECT\n        PD.CODPROD, PD.DESCRPROD, PD.UNIDADE, PD.GRUPO, PD.GRUPO_DESCR, PD.CURVA_ABC,\n        PD.MULTIPLO_COMPRA, PD.LOTE_MINIMO, PD.ESTOQUE_MIN_PARAM,\n        NVL(PD.FL_SOB_ENCOMENDA, 0) AS FL_SOB_ENCOMENDA,\n        NVL(PD.FL_CONSIGNADO, 0) AS FL_CONSIGNADO,\n        NVL(ES.QTD, 0) AS QTD_ESTOQUE,\n        NVL(EM.QTD, 0) AS QTD_EMPENHADA,\n        NVL(ES.QTD, 0) - NVL(EM.QTD, 0) AS QTD_DISPONIVEL,\n        NVL(OA.QTD, 0) AS QTD_PENDENTE,\n        NVL(OA.N_OCS, 0) AS N_OCS_ABERTAS,\n        NVL(CU.VLR_UNIT, 0) AS VLR_UNIT,\n        CASE WHEN PD.LEADTIME_PARAM_DIAS > 0 THEN PD.LEADTIME_PARAM_DIAS ELSE PR.LT_PADRAO END AS LEADTIME,\n        CASE WHEN PD.LEADTIME_PARAM_DIAS > 0 THEN 0 ELSE 1 END AS FL_LT_PADRAO,\n        NVL(CO.QTD_JANELA, 0) AS QTD_JANELA,\n        NVL(CO.QTD_3M, 0) AS QTD_3M,\n        GREATEST(0, NVL(CO.QTD_JANELA, 0) / DV.DIVISOR) AS MEDIA_SIMPLES,\n        GREATEST(0, 0.5 * NVL(CO.QTD_3M, 0) / 3 + 0.3 * NVL(CO.QTD_6M, 0) / 6\n                    + 0.2 * NVL(CO.QTD_JANELA, 0) / DV.DIVISOR) AS MEDIA_PONDERADA,\n        CASE UPPER(NVL(PD.CURVA_ABC, 'C')) WHEN 'A' THEN PR.COB_A WHEN 'B' THEN PR.COB_B ELSE PR.COB_C END AS COB_ALVO,\n        PR.MEDIA_MODO, PR.DIAS_MES, PR.MARGEM, PR.COB_MAX, PR.SEG_FRAC\n    FROM (SELECT\n    P.CODPROD                                                AS CODPROD,\n    P.DESCRPROD                                              AS DESCRPROD,\n    P.REFERENCIA                                             AS REFERENCIA,\n    P.CODVOL                                                 AS UNIDADE,\n    P.MARCA                                                  AS MARCA,\n    P.CODGRUPOPROD                                           AS GRUPO,\n    G.DESCRGRUPOPROD                                         AS GRUPO_DESCR,\n    CASE WHEN P.ATIVO = 'S' THEN 1 ELSE 0 END                AS FL_ATIVO,\n    CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END             AS LEADTIME_PARAM_DIAS,\n    CASE WHEN P.ESTMIN > 0 THEN P.ESTMIN END                 AS ESTOQUE_MIN_PARAM,\n    CAST(NULL AS VARCHAR2(1))                                AS CURVA_ABC,\n    CASE WHEN P.AGRUPMIN > 1 THEN P.AGRUPMIN END             AS MULTIPLO_COMPRA,\n    CASE WHEN P.LOTECOMPMINIMO > 0 THEN P.LOTECOMPMINIMO END AS LOTE_MINIMO,\n    0                                                        AS FL_SOB_ENCOMENDA,\n    CASE WHEN NVL(P.CODPARCCONSIG, 0) > 0 THEN 1 ELSE 0 END  AS FL_CONSIGNADO\nFROM TGFPRO P\nLEFT JOIN TGFGRU G ON G.CODGRUPOPROD = P.CODGRUPOPROD) PD\n    CROSS JOIN prm PR\n    CROSS JOIN dvs DV\n    LEFT JOIN est ES ON ES.CODPROD = PD.CODPROD\n    LEFT JOIN emp EM ON EM.CODPROD = PD.CODPROD\n    LEFT JOIN ocab OA ON OA.CODPROD = PD.CODPROD\n    LEFT JOIN custo CU ON CU.CODPROD = PD.CODPROD\n    LEFT JOIN cons CO ON CO.CODPROD = PD.CODPROD\n    WHERE PD.FL_ATIVO = 1\n),\nmed AS (\n    SELECT BA.*,\n           CASE WHEN BA.MEDIA_MODO = 1 THEN BA.MEDIA_PONDERADA ELSE BA.MEDIA_SIMPLES END AS MEDIA_USADA\n    FROM base BA\n),\ndem AS (\n    SELECT ME.*, ME.MEDIA_USADA / ME.DIAS_MES AS DEMANDA_DIARIA FROM med ME\n),\ncob AS (\n    SELECT DE.*,\n        CASE WHEN DE.DEMANDA_DIARIA > 0 THEN DE.QTD_DISPONIVEL / DE.DEMANDA_DIARIA ELSE 999 END AS DIAS_EST_ATUAL,\n        CASE WHEN DE.DEMANDA_DIARIA > 0 THEN (DE.QTD_DISPONIVEL + DE.QTD_PENDENTE) / DE.DEMANDA_DIARIA ELSE 999 END AS DIAS_EST,\n        DE.DEMANDA_DIARIA * DE.LEADTIME * (1 + DE.SEG_FRAC) AS EST_MIN_CALC,\n        CASE WHEN DE.QTD_DISPONIVEL < 0 THEN -DE.QTD_DISPONIVEL * DE.VLR_UNIT ELSE 0 END AS RUPTURA_VALOR,\n        CASE WHEN DE.FL_SOB_ENCOMENDA = 1 OR DE.FL_CONSIGNADO = 1 OR DE.QTD_JANELA <= 0 THEN 0\n             ELSE GREATEST(0, DE.DEMANDA_DIARIA * (DE.LEADTIME + DE.COB_ALVO)\n                              - (DE.QTD_DISPONIVEL + DE.QTD_PENDENTE)) END AS QTD_BRUTA\n    FROM dem DE\n),\nmult AS (\n    SELECT CB.*,\n        CASE WHEN CB.QTD_BRUTA <= 0 THEN 0\n             WHEN NVL(CB.MULTIPLO_COMPRA, 0) > 0 THEN CEIL(CB.QTD_BRUTA / CB.MULTIPLO_COMPRA) * CB.MULTIPLO_COMPRA\n             ELSE CEIL(CB.QTD_BRUTA) END AS QTD_MULT\n    FROM cob CB\n),\nsop AS (\n    SELECT MU.*,\n        CASE WHEN MU.QTD_MULT > 0 AND NVL(MU.LOTE_MINIMO, 0) > MU.QTD_MULT\n             THEN CASE WHEN NVL(MU.MULTIPLO_COMPRA, 0) > 0\n                       THEN CEIL(MU.LOTE_MINIMO / MU.MULTIPLO_COMPRA) * MU.MULTIPLO_COMPRA\n                       ELSE MU.LOTE_MINIMO END\n             ELSE MU.QTD_MULT END AS QTD_SUGERIDA,\n        CASE WHEN MU.QTD_DISPONIVEL < 0 OR (MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST <= 0) THEN 'P1_CRITICO'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME               THEN 'P2_RUPTURA_IMINENTE'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME + MU.MARGEM   THEN 'P3_ATENCAO'\n             WHEN MU.QTD_ESTOQUE > 0 AND MU.QTD_JANELA <= 0                         THEN 'P0_EXCESSO_SEM_GIRO'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST > MU.COB_MAX                THEN 'P0_EXCESSO'\n             ELSE 'OK' END AS PRIORIDADE,\n        CASE WHEN MU.QTD_DISPONIVEL < 0                                             THEN 'RUPTURA'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME               THEN 'PONTO_PEDIDO'\n             WHEN MU.ESTOQUE_MIN_PARAM > 0 AND MU.QTD_DISPONIVEL < MU.ESTOQUE_MIN_PARAM THEN 'MINIMO_CURVA_A'\n             ELSE 'SEM_DISPARO' END AS REGRA_DISPARO\n    FROM mult MU\n)\nSELECT S.CODPROD, S.DESCRPROD, S.UNIDADE, S.PRIORIDADE,\n       ROUND(S.RUPTURA_VALOR, 2) AS RUPTURA_VALOR,\n       ROUND(S.QTD_DISPONIVEL, 2) AS QTD_DISPONIVEL,\n       ROUND(S.DIAS_EST, 1) AS DIAS_EST\nFROM sop S\nWHERE S.RUPTURA_VALOR > 0\nORDER BY S.RUPTURA_VALOR DESC, S.CODPROD\nFETCH FIRST 15 ROWS ONLY","params":["CODEMP","DIAS_MES_X10000","MARGEM_ATENCAO_DIAS","COBERTURA_MAX_DIAS","SEGURANCA_X10000","COBERTURA_ALVO_A","COBERTURA_ALVO_B","COBERTURA_ALVO_C","LEADTIME_DEFAULT","MEDIA_MODO","MESES_MEDIA","DIVISOR_MEDIA","INCLUI_MES_ATUAL"],"tipos":["I","I","I","I","I","I","I","I","I","I","I","I","I"]},"Q_FILA":{"sql":"WITH prm AS (\n    SELECT\n        TO_NUMBER(?)          AS CODEMP,\n        TO_NUMBER(?) / 10000  AS DIAS_MES,\n        TO_NUMBER(?)          AS MARGEM,\n        TO_NUMBER(?)          AS COB_MAX,\n        TO_NUMBER(?) / 10000  AS SEG_FRAC,\n        TO_NUMBER(?)          AS COB_A,\n        TO_NUMBER(?)          AS COB_B,\n        TO_NUMBER(?)          AS COB_C,\n        TO_NUMBER(?)          AS LT_PADRAO,\n        TO_NUMBER(?)          AS MEDIA_MODO,\n        TO_NUMBER(?)          AS MESES_MEDIA,\n        TO_NUMBER(?)          AS DIVISOR_MEDIA,\n        TO_NUMBER(?)          AS INCLUI_MES_ATUAL\n    FROM DUAL\n), jan AS (\n    SELECT\n        CASE WHEN PR.INCLUI_MES_ATUAL = 1 THEN TRUNC(SYSDATE, 'MM')\n             ELSE ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -1) END AS FIM,\n        GREATEST(1, PR.MESES_MEDIA) AS NMESES\n    FROM prm PR\n),\njan2 AS (\n    SELECT JA.FIM, JA.NMESES, ADD_MONTHS(JA.FIM, 1 - JA.NMESES) AS INI FROM jan JA\n),\ncons_mes AS (\n    SELECT CM.CODPROD, CM.ANO_MES,\n           SUM(NVL(CM.QTD_VENDA, 0) + NVL(CM.QTD_PERDA, 0) - NVL(CM.QTD_DEVOLUCAO, 0)) AS QTD\n    FROM (SELECT\n    X.CODPROD                                                     AS CODPROD,\n    X.CODEMP                                                      AS CODEMP,\n    X.ANO_MES                                                     AS ANO_MES,\n    SUM(CASE WHEN X.PAPEL = 'CONSUMO'   THEN X.QTD_BASE ELSE 0 END) AS QTD_VENDA,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN X.QTD_BASE ELSE 0 END) AS QTD_DEVOLUCAO,\n    SUM(CASE WHEN X.PAPEL = 'PERDA'     THEN X.QTD_BASE ELSE 0 END) AS QTD_PERDA,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN -X.QTD_BASE ELSE X.QTD_BASE END) AS QTD_CONSUMO,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN -X.VLR ELSE X.VLR END)           AS VLR_CONSUMO,\n    SUM(CASE WHEN X.FATOR IS NULL THEN 1 ELSE 0 END)              AS ITENS_SEM_CONVERSAO\nFROM (\n    SELECT\n        I.CODPROD, C.CODEMP, TP.PAPEL,\n        TO_CHAR(C.DTNEG, 'YYYY-MM')                 AS ANO_MES,\n        NVL(I.QTDNEG, 0) * NVL(\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END, 1)                                  AS QTD_BASE,\n        NVL(I.VLRTOT, 0)                             AS VLR,\n        CASE WHEN I.CODVOL = P.CODVOL THEN 1\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n        END                                          AS FATOR\n    FROM TGFCAB C\n    JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL IN ('CONSUMO', 'DEVOLUCAO', 'PERDA')\n    JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n    JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n    LEFT JOIN (\n        SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n               COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n        FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n    ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n    WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -36)\n      AND C.STATUSNOTA = 'L'\n) X\nGROUP BY X.CODPROD, X.CODEMP, X.ANO_MES) CM\n    CROSS JOIN prm PR\n    CROSS JOIN jan2 J\n    WHERE CM.ANO_MES >= TO_CHAR(J.INI, 'YYYY-MM')\n      AND CM.ANO_MES <= TO_CHAR(J.FIM, 'YYYY-MM')\n      AND (PR.CODEMP = 0 OR CM.CODEMP = PR.CODEMP)\n    GROUP BY CM.CODPROD, CM.ANO_MES\n),\ndvs AS (\n    SELECT\n        CASE WHEN PR.DIVISOR_MEDIA > 0 THEN PR.DIVISOR_MEDIA\n             ELSE (SELECT GREATEST(1, COUNT(DISTINCT XM.ANO_MES)) FROM cons_mes XM) END AS DIVISOR,\n        CASE WHEN PR.DIVISOR_MEDIA > 0 THEN 'PARAMETRO' ELSE 'MESES_COM_DADOS' END AS ORIGEM_DIVISOR\n    FROM prm PR\n),\ncons AS (\n    SELECT CS.CODPROD,\n           SUM(CS.QTD) AS QTD_JANELA,\n           SUM(CASE WHEN CS.ANO_MES >= TO_CHAR(ADD_MONTHS(J.FIM, -2), 'YYYY-MM') THEN CS.QTD ELSE 0 END) AS QTD_3M,\n           SUM(CASE WHEN CS.ANO_MES >= TO_CHAR(ADD_MONTHS(J.FIM, -5), 'YYYY-MM') THEN CS.QTD ELSE 0 END) AS QTD_6M\n    FROM cons_mes CS\n    CROSS JOIN jan2 J\n    GROUP BY CS.CODPROD\n),\nest AS (\n    SELECT ES0.CODPROD, SUM(NVL(ES0.QTD_ESTOQUE, 0)) AS QTD\n    FROM (SELECT\n    E.CODPROD                         AS CODPROD,\n    E.CODEMP                          AS CODEMP,\n    SUM(NVL(E.ESTOQUE, 0))            AS QTD_ESTOQUE,\n    SUM(NVL(E.RESERVADO, 0))          AS QTD_RESERVADO,\n    SUM(NVL(E.WMSBLOQUEADO, 0))       AS QTD_BLOQUEADO\nFROM TGFEST E\nWHERE E.CODLOCAL NOT IN (1030000, 2030000)\nGROUP BY E.CODPROD, E.CODEMP) ES0\n    CROSS JOIN prm PR\n    WHERE (PR.CODEMP = 0 OR ES0.CODEMP = PR.CODEMP)\n    GROUP BY ES0.CODPROD\n),\nemp AS (\n    SELECT EM0.CODPROD, SUM(NVL(EM0.QTD_EMPENHADA, 0)) AS QTD\n    FROM (SELECT\n    X.CODPROD                                     AS CODPROD,\n    X.CODEMP                                      AS CODEMP,\n    SUM(X.QTD_ABERTA * NVL(X.FATOR, 1))           AS QTD_EMPENHADA,\n    SUM(X.QTD_ABERTA * X.VLRUNIT)                 AS VLR_EMPENHADO,\n    SUM(CASE WHEN X.FATOR IS NULL THEN 1 ELSE 0 END) AS ITENS_SEM_CONVERSAO\nFROM (\n    SELECT\n        I.CODPROD, C.CODEMP, NVL(I.VLRUNIT, 0) AS VLRUNIT,\n        GREATEST(NVL(I.QTDNEG, 0) - NVL(I.QTDENTREGUE, 0) - NVL(I.QTDCONFERIDA, 0), 0) AS QTD_ABERTA,\n        CASE WHEN I.CODVOL = P.CODVOL THEN 1\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n        END AS FATOR\n    FROM TGFCAB C\n    JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'EMPENHO'\n    JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n    JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n    LEFT JOIN (\n        SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n               COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n        FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n    ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n    WHERE I.PENDENTE = 'S'\n      AND NVL(I.CANCELADO, 'N') <> 'S'\n) X\nWHERE X.QTD_ABERTA > 0\nGROUP BY X.CODPROD, X.CODEMP) EM0\n    CROSS JOIN prm PR\n    WHERE (PR.CODEMP = 0 OR EM0.CODEMP = PR.CODEMP)\n    GROUP BY EM0.CODPROD\n),\nocx AS (\n    SELECT OX.CODPROD, OX.NUNOTA, OX.SEQUENCIA, OX.CODEMP, OX.STATUS_OC, OX.QTD_PENDENTE,\n           OX.VLR_UNIT, OX.DT_NEGOCIACAO\n    FROM (SELECT\n    Z.NUNOTA, Z.SEQUENCIA, Z.CODEMP, Z.CODPARC, Z.FORNECEDOR, Z.CODTIPOPER, Z.DESCRICAO_TOP,\n    Z.CODPROD, Z.OS,\n    Z.QTDNEG * NVL(Z.FATOR, 1)                                       AS QTD_NEGOCIADA,\n    Z.QTDENTREGUE * NVL(Z.FATOR, 1)                                  AS QTD_ENTREGUE,\n    CASE WHEN Z.ABERTA = 1 THEN (Z.QTDNEG - Z.QTDENTREGUE) * NVL(Z.FATOR, 1) ELSE 0 END AS QTD_PENDENTE,\n    CASE WHEN Z.QTDNEG * NVL(Z.FATOR, 1) > 0 THEN Z.VLRTOT / (Z.QTDNEG * NVL(Z.FATOR, 1)) ELSE 0 END AS VLR_UNIT,\n    Z.VLRTOT                                                         AS VLR_TOTAL,\n    Z.DT_NEGOCIACAO,\n    Z.DT_ENTREGA_PREVISTA,\n    Z.PREVISAO_ORIGEM,\n    NVL(Z.DT_LIBERACAO, CASE WHEN Z.STATUSNOTA = 'L' THEN Z.DT_NEGOCIACAO END) AS DT_APROVACAO,\n    Z.DT_ENTREGA_REAL,\n    CASE WHEN Z.CANCELADO = 'S'                              THEN 'CANCELADA'\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG     THEN 'ENTREGUE'\n         WHEN Z.PENDENTE = 'N' AND Z.QTDENTREGUE > 0         THEN 'ENCERRADA_PARCIAL'\n         WHEN Z.PENDENTE = 'N'                               THEN 'ENCERRADA_SEM_RECEBER'\n         WHEN Z.QTDENTREGUE > 0                              THEN 'ENTREGA_PARCIAL'\n         WHEN Z.STATUSNOTA = 'L'                             THEN 'APROVADA_NAO_ENTREGUE'\n         ELSE 'ABERTA_NAO_APROVADA'\n    END                                                              AS STATUS_OC,\n    CASE WHEN Z.ABERTA = 1 AND Z.DT_ENTREGA_PREVISTA < TRUNC(SYSDATE)\n              THEN TRUNC(SYSDATE) - Z.DT_ENTREGA_PREVISTA\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG\n              AND Z.DT_ENTREGA_REAL IS NOT NULL AND Z.DT_ENTREGA_PREVISTA IS NOT NULL\n              THEN Z.DT_ENTREGA_REAL - Z.DT_ENTREGA_PREVISTA\n         ELSE 0\n    END                                                              AS DIAS_ATRASO,\n    CASE WHEN Z.FATOR IS NULL THEN 1 ELSE 0 END                      AS FL_SEM_CONVERSAO\nFROM (\n    SELECT Y.*,\n        CASE WHEN Y.CANCELADO <> 'S' AND Y.PENDENTE = 'S' AND Y.QTDENTREGUE < Y.QTDNEG THEN 1 ELSE 0 END AS ABERTA,\n        CASE WHEN Y.QTDENTREGUE > 0 THEN COALESCE(\n            (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFVAR V JOIN TGFCAB N ON N.NUNOTA = V.NUNOTA\n              WHERE V.NUNOTAORIG = Y.NUNOTA AND V.SEQUENCIAORIG = Y.SEQUENCIA AND V.NUNOTA <> Y.NUNOTA),\n            CASE WHEN Y.OS IS NOT NULL THEN\n                (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFITE E JOIN TGFCAB N ON N.NUNOTA = E.NUNOTA\n                  WHERE N.CODTIPOPER IN (259, 200) AND N.STATUSNOTA = 'L'\n                    AND TRIM(E.AD_OS) = Y.OS AND E.CODPROD = Y.CODPROD\n                    AND N.DTNEG >= Y.DT_NEGOCIACAO - 365)\n            END)\n        END AS DT_ENTREGA_REAL\n    FROM (\n        SELECT\n            C.NUNOTA, I.SEQUENCIA, C.CODEMP, C.CODPARC, PA.NOMEPARC AS FORNECEDOR,\n            C.CODTIPOPER, T.DESCROPER AS DESCRICAO_TOP, I.CODPROD,\n            TRIM(C.AD_OSTUICIAL)                     AS OS,\n            C.STATUSNOTA, NVL(I.PENDENTE, 'S')       AS PENDENTE, NVL(I.CANCELADO, 'N') AS CANCELADO,\n            NVL(I.QTDNEG, 0)                         AS QTDNEG,\n            NVL(I.QTDENTREGUE, 0)                    AS QTDENTREGUE,\n            NVL(I.VLRTOT, 0)                         AS VLRTOT,\n            TRUNC(C.DTNEG)                           AS DT_NEGOCIACAO,\n            COALESCE(TRUNC(C.DTPREVENT), TRUNC(C.DTNEG) + CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END) AS DT_ENTREGA_PREVISTA,\n            CASE WHEN C.DTPREVENT IS NOT NULL THEN 'DTPREVENT'\n                 WHEN P.LEADTIME > 0 THEN 'OC+LEADTIME' END AS PREVISAO_ORIGEM,\n            (SELECT TRUNC(MAX(L.DHLIB)) FROM TSILIB L\n              WHERE L.TABELA = 'TGFCAB' AND L.NUCHAVE = C.NUNOTA\n                AND L.DHLIB IS NOT NULL AND NVL(L.REPROVADO, 'N') <> 'S') AS DT_LIBERACAO,\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END                                      AS FATOR\n        FROM TGFCAB C\n        JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'ORDEM_COMPRA'\n        JOIN TGFTOP T ON T.CODTIPOPER = C.CODTIPOPER AND T.DHALTER = C.DHTIPOPER\n        JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n        JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n        LEFT JOIN TGFPAR PA ON PA.CODPARC = C.CODPARC\n        LEFT JOIN (\n            SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n                   COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n            FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n        ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n        WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -24)\n    ) Y\n) Z) OX\n),\nocab AS (\n    SELECT OA0.CODPROD, SUM(OA0.QTD_PENDENTE) AS QTD, COUNT(DISTINCT OA0.NUNOTA) AS N_OCS\n    FROM ocx OA0\n    CROSS JOIN prm PR\n    WHERE OA0.STATUS_OC IN ('ABERTA_NAO_APROVADA', 'APROVADA_NAO_ENTREGUE', 'ENTREGA_PARCIAL')\n      AND OA0.QTD_PENDENTE > 0\n      AND (PR.CODEMP = 0 OR OA0.CODEMP = PR.CODEMP)\n    GROUP BY OA0.CODPROD\n),\ncusto AS (\n    SELECT CU0.CODPROD, CU0.VLR_UNIT\n    FROM (\n        SELECT CX.CODPROD, CX.VLR_UNIT,\n               ROW_NUMBER() OVER (PARTITION BY CX.CODPROD\n                                  ORDER BY CX.DT_NEGOCIACAO DESC, CX.NUNOTA DESC, CX.SEQUENCIA DESC) AS RN\n        FROM ocx CX\n        WHERE CX.VLR_UNIT > 0 AND CX.STATUS_OC <> 'CANCELADA'\n    ) CU0\n    WHERE CU0.RN = 1\n),\nbase AS (\n    SELECT\n        PD.CODPROD, PD.DESCRPROD, PD.UNIDADE, PD.GRUPO, PD.GRUPO_DESCR, PD.CURVA_ABC,\n        PD.MULTIPLO_COMPRA, PD.LOTE_MINIMO, PD.ESTOQUE_MIN_PARAM,\n        NVL(PD.FL_SOB_ENCOMENDA, 0) AS FL_SOB_ENCOMENDA,\n        NVL(PD.FL_CONSIGNADO, 0) AS FL_CONSIGNADO,\n        NVL(ES.QTD, 0) AS QTD_ESTOQUE,\n        NVL(EM.QTD, 0) AS QTD_EMPENHADA,\n        NVL(ES.QTD, 0) - NVL(EM.QTD, 0) AS QTD_DISPONIVEL,\n        NVL(OA.QTD, 0) AS QTD_PENDENTE,\n        NVL(OA.N_OCS, 0) AS N_OCS_ABERTAS,\n        NVL(CU.VLR_UNIT, 0) AS VLR_UNIT,\n        CASE WHEN PD.LEADTIME_PARAM_DIAS > 0 THEN PD.LEADTIME_PARAM_DIAS ELSE PR.LT_PADRAO END AS LEADTIME,\n        CASE WHEN PD.LEADTIME_PARAM_DIAS > 0 THEN 0 ELSE 1 END AS FL_LT_PADRAO,\n        NVL(CO.QTD_JANELA, 0) AS QTD_JANELA,\n        NVL(CO.QTD_3M, 0) AS QTD_3M,\n        GREATEST(0, NVL(CO.QTD_JANELA, 0) / DV.DIVISOR) AS MEDIA_SIMPLES,\n        GREATEST(0, 0.5 * NVL(CO.QTD_3M, 0) / 3 + 0.3 * NVL(CO.QTD_6M, 0) / 6\n                    + 0.2 * NVL(CO.QTD_JANELA, 0) / DV.DIVISOR) AS MEDIA_PONDERADA,\n        CASE UPPER(NVL(PD.CURVA_ABC, 'C')) WHEN 'A' THEN PR.COB_A WHEN 'B' THEN PR.COB_B ELSE PR.COB_C END AS COB_ALVO,\n        PR.MEDIA_MODO, PR.DIAS_MES, PR.MARGEM, PR.COB_MAX, PR.SEG_FRAC\n    FROM (SELECT\n    P.CODPROD                                                AS CODPROD,\n    P.DESCRPROD                                              AS DESCRPROD,\n    P.REFERENCIA                                             AS REFERENCIA,\n    P.CODVOL                                                 AS UNIDADE,\n    P.MARCA                                                  AS MARCA,\n    P.CODGRUPOPROD                                           AS GRUPO,\n    G.DESCRGRUPOPROD                                         AS GRUPO_DESCR,\n    CASE WHEN P.ATIVO = 'S' THEN 1 ELSE 0 END                AS FL_ATIVO,\n    CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END             AS LEADTIME_PARAM_DIAS,\n    CASE WHEN P.ESTMIN > 0 THEN P.ESTMIN END                 AS ESTOQUE_MIN_PARAM,\n    CAST(NULL AS VARCHAR2(1))                                AS CURVA_ABC,\n    CASE WHEN P.AGRUPMIN > 1 THEN P.AGRUPMIN END             AS MULTIPLO_COMPRA,\n    CASE WHEN P.LOTECOMPMINIMO > 0 THEN P.LOTECOMPMINIMO END AS LOTE_MINIMO,\n    0                                                        AS FL_SOB_ENCOMENDA,\n    CASE WHEN NVL(P.CODPARCCONSIG, 0) > 0 THEN 1 ELSE 0 END  AS FL_CONSIGNADO\nFROM TGFPRO P\nLEFT JOIN TGFGRU G ON G.CODGRUPOPROD = P.CODGRUPOPROD) PD\n    CROSS JOIN prm PR\n    CROSS JOIN dvs DV\n    LEFT JOIN est ES ON ES.CODPROD = PD.CODPROD\n    LEFT JOIN emp EM ON EM.CODPROD = PD.CODPROD\n    LEFT JOIN ocab OA ON OA.CODPROD = PD.CODPROD\n    LEFT JOIN custo CU ON CU.CODPROD = PD.CODPROD\n    LEFT JOIN cons CO ON CO.CODPROD = PD.CODPROD\n    WHERE PD.FL_ATIVO = 1\n),\nmed AS (\n    SELECT BA.*,\n           CASE WHEN BA.MEDIA_MODO = 1 THEN BA.MEDIA_PONDERADA ELSE BA.MEDIA_SIMPLES END AS MEDIA_USADA\n    FROM base BA\n),\ndem AS (\n    SELECT ME.*, ME.MEDIA_USADA / ME.DIAS_MES AS DEMANDA_DIARIA FROM med ME\n),\ncob AS (\n    SELECT DE.*,\n        CASE WHEN DE.DEMANDA_DIARIA > 0 THEN DE.QTD_DISPONIVEL / DE.DEMANDA_DIARIA ELSE 999 END AS DIAS_EST_ATUAL,\n        CASE WHEN DE.DEMANDA_DIARIA > 0 THEN (DE.QTD_DISPONIVEL + DE.QTD_PENDENTE) / DE.DEMANDA_DIARIA ELSE 999 END AS DIAS_EST,\n        DE.DEMANDA_DIARIA * DE.LEADTIME * (1 + DE.SEG_FRAC) AS EST_MIN_CALC,\n        CASE WHEN DE.QTD_DISPONIVEL < 0 THEN -DE.QTD_DISPONIVEL * DE.VLR_UNIT ELSE 0 END AS RUPTURA_VALOR,\n        CASE WHEN DE.FL_SOB_ENCOMENDA = 1 OR DE.FL_CONSIGNADO = 1 OR DE.QTD_JANELA <= 0 THEN 0\n             ELSE GREATEST(0, DE.DEMANDA_DIARIA * (DE.LEADTIME + DE.COB_ALVO)\n                              - (DE.QTD_DISPONIVEL + DE.QTD_PENDENTE)) END AS QTD_BRUTA\n    FROM dem DE\n),\nmult AS (\n    SELECT CB.*,\n        CASE WHEN CB.QTD_BRUTA <= 0 THEN 0\n             WHEN NVL(CB.MULTIPLO_COMPRA, 0) > 0 THEN CEIL(CB.QTD_BRUTA / CB.MULTIPLO_COMPRA) * CB.MULTIPLO_COMPRA\n             ELSE CEIL(CB.QTD_BRUTA) END AS QTD_MULT\n    FROM cob CB\n),\nsop AS (\n    SELECT MU.*,\n        CASE WHEN MU.QTD_MULT > 0 AND NVL(MU.LOTE_MINIMO, 0) > MU.QTD_MULT\n             THEN CASE WHEN NVL(MU.MULTIPLO_COMPRA, 0) > 0\n                       THEN CEIL(MU.LOTE_MINIMO / MU.MULTIPLO_COMPRA) * MU.MULTIPLO_COMPRA\n                       ELSE MU.LOTE_MINIMO END\n             ELSE MU.QTD_MULT END AS QTD_SUGERIDA,\n        CASE WHEN MU.QTD_DISPONIVEL < 0 OR (MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST <= 0) THEN 'P1_CRITICO'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME               THEN 'P2_RUPTURA_IMINENTE'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME + MU.MARGEM   THEN 'P3_ATENCAO'\n             WHEN MU.QTD_ESTOQUE > 0 AND MU.QTD_JANELA <= 0                         THEN 'P0_EXCESSO_SEM_GIRO'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST > MU.COB_MAX                THEN 'P0_EXCESSO'\n             ELSE 'OK' END AS PRIORIDADE,\n        CASE WHEN MU.QTD_DISPONIVEL < 0                                             THEN 'RUPTURA'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME               THEN 'PONTO_PEDIDO'\n             WHEN MU.ESTOQUE_MIN_PARAM > 0 AND MU.QTD_DISPONIVEL < MU.ESTOQUE_MIN_PARAM THEN 'MINIMO_CURVA_A'\n             ELSE 'SEM_DISPARO' END AS REGRA_DISPARO\n    FROM mult MU\n)\nSELECT S.CODPROD, S.DESCRPROD, S.UNIDADE, S.GRUPO, S.GRUPO_DESCR, S.CURVA_ABC, S.PRIORIDADE,\n       ROUND(S.QTD_ESTOQUE, 2)                AS QTD_ESTOQUE,\n       ROUND(S.QTD_DISPONIVEL, 2)             AS QTD_DISPONIVEL,\n       ROUND(S.QTD_EMPENHADA, 2)              AS QTD_EMPENHADA,\n       ROUND(S.QTD_PENDENTE, 2)               AS QTD_PENDENTE,\n       ROUND(S.DEMANDA_DIARIA, 4)             AS DD,\n       ROUND(S.DIAS_EST, 1)                   AS DIAS_EST,\n       S.LEADTIME, S.FL_LT_PADRAO,\n       ROUND(S.EST_MIN_CALC, 2)               AS EST_MIN_CALC,\n       ROUND(S.QTD_BRUTA, 2)                  AS QTD_BRUTA,\n       S.QTD_SUGERIDA,\n       ROUND(S.QTD_SUGERIDA * S.VLR_UNIT, 2)  AS VLR_SUGERIDO,\n       ROUND(S.VLR_UNIT, 6)                   AS VLR_UNIT,\n       ROUND(S.RUPTURA_VALOR, 2)              AS RUPTURA_VALOR,\n       S.REGRA_DISPARO, S.N_OCS_ABERTAS, S.MULTIPLO_COMPRA, S.LOTE_MINIMO,\n       COUNT(*) OVER ()                       AS TOTAL_LINHAS\nFROM sop S\nWHERE S.PRIORIDADE IN ('P1_CRITICO', 'P2_RUPTURA_IMINENTE', 'P3_ATENCAO') OR S.QTD_SUGERIDA > 0\nORDER BY CASE S.PRIORIDADE WHEN 'P1_CRITICO' THEN 1 WHEN 'P2_RUPTURA_IMINENTE' THEN 2\n                           WHEN 'P3_ATENCAO' THEN 3 WHEN 'P0_EXCESSO' THEN 4\n                           WHEN 'P0_EXCESSO_SEM_GIRO' THEN 5 ELSE 6 END,\n         S.RUPTURA_VALOR DESC, S.DIAS_EST ASC, S.CODPROD\nFETCH FIRST ? ROWS ONLY","params":["CODEMP","DIAS_MES_X10000","MARGEM_ATENCAO_DIAS","COBERTURA_MAX_DIAS","SEGURANCA_X10000","COBERTURA_ALVO_A","COBERTURA_ALVO_B","COBERTURA_ALVO_C","LEADTIME_DEFAULT","MEDIA_MODO","MESES_MEDIA","DIVISOR_MEDIA","INCLUI_MES_ATUAL","LIMITE_FILA"],"tipos":["I","I","I","I","I","I","I","I","I","I","I","I","I","I"]},"Q_NAO_COBRE":{"sql":"WITH prm AS (\n    SELECT\n        TO_NUMBER(?)          AS CODEMP,\n        TO_NUMBER(?) / 10000  AS DIAS_MES,\n        TO_NUMBER(?)          AS MARGEM,\n        TO_NUMBER(?)          AS COB_MAX,\n        TO_NUMBER(?) / 10000  AS SEG_FRAC,\n        TO_NUMBER(?)          AS COB_A,\n        TO_NUMBER(?)          AS COB_B,\n        TO_NUMBER(?)          AS COB_C,\n        TO_NUMBER(?)          AS LT_PADRAO,\n        TO_NUMBER(?)          AS MEDIA_MODO,\n        TO_NUMBER(?)          AS MESES_MEDIA,\n        TO_NUMBER(?)          AS DIVISOR_MEDIA,\n        TO_NUMBER(?)          AS INCLUI_MES_ATUAL\n    FROM DUAL\n), jan AS (\n    SELECT\n        CASE WHEN PR.INCLUI_MES_ATUAL = 1 THEN TRUNC(SYSDATE, 'MM')\n             ELSE ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -1) END AS FIM,\n        GREATEST(1, PR.MESES_MEDIA) AS NMESES\n    FROM prm PR\n),\njan2 AS (\n    SELECT JA.FIM, JA.NMESES, ADD_MONTHS(JA.FIM, 1 - JA.NMESES) AS INI FROM jan JA\n),\ncons_mes AS (\n    SELECT CM.CODPROD, CM.ANO_MES,\n           SUM(NVL(CM.QTD_VENDA, 0) + NVL(CM.QTD_PERDA, 0) - NVL(CM.QTD_DEVOLUCAO, 0)) AS QTD\n    FROM (SELECT\n    X.CODPROD                                                     AS CODPROD,\n    X.CODEMP                                                      AS CODEMP,\n    X.ANO_MES                                                     AS ANO_MES,\n    SUM(CASE WHEN X.PAPEL = 'CONSUMO'   THEN X.QTD_BASE ELSE 0 END) AS QTD_VENDA,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN X.QTD_BASE ELSE 0 END) AS QTD_DEVOLUCAO,\n    SUM(CASE WHEN X.PAPEL = 'PERDA'     THEN X.QTD_BASE ELSE 0 END) AS QTD_PERDA,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN -X.QTD_BASE ELSE X.QTD_BASE END) AS QTD_CONSUMO,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN -X.VLR ELSE X.VLR END)           AS VLR_CONSUMO,\n    SUM(CASE WHEN X.FATOR IS NULL THEN 1 ELSE 0 END)              AS ITENS_SEM_CONVERSAO\nFROM (\n    SELECT\n        I.CODPROD, C.CODEMP, TP.PAPEL,\n        TO_CHAR(C.DTNEG, 'YYYY-MM')                 AS ANO_MES,\n        NVL(I.QTDNEG, 0) * NVL(\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END, 1)                                  AS QTD_BASE,\n        NVL(I.VLRTOT, 0)                             AS VLR,\n        CASE WHEN I.CODVOL = P.CODVOL THEN 1\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n        END                                          AS FATOR\n    FROM TGFCAB C\n    JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL IN ('CONSUMO', 'DEVOLUCAO', 'PERDA')\n    JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n    JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n    LEFT JOIN (\n        SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n               COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n        FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n    ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n    WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -36)\n      AND C.STATUSNOTA = 'L'\n) X\nGROUP BY X.CODPROD, X.CODEMP, X.ANO_MES) CM\n    CROSS JOIN prm PR\n    CROSS JOIN jan2 J\n    WHERE CM.ANO_MES >= TO_CHAR(J.INI, 'YYYY-MM')\n      AND CM.ANO_MES <= TO_CHAR(J.FIM, 'YYYY-MM')\n      AND (PR.CODEMP = 0 OR CM.CODEMP = PR.CODEMP)\n    GROUP BY CM.CODPROD, CM.ANO_MES\n),\ndvs AS (\n    SELECT\n        CASE WHEN PR.DIVISOR_MEDIA > 0 THEN PR.DIVISOR_MEDIA\n             ELSE (SELECT GREATEST(1, COUNT(DISTINCT XM.ANO_MES)) FROM cons_mes XM) END AS DIVISOR,\n        CASE WHEN PR.DIVISOR_MEDIA > 0 THEN 'PARAMETRO' ELSE 'MESES_COM_DADOS' END AS ORIGEM_DIVISOR\n    FROM prm PR\n),\ncons AS (\n    SELECT CS.CODPROD,\n           SUM(CS.QTD) AS QTD_JANELA,\n           SUM(CASE WHEN CS.ANO_MES >= TO_CHAR(ADD_MONTHS(J.FIM, -2), 'YYYY-MM') THEN CS.QTD ELSE 0 END) AS QTD_3M,\n           SUM(CASE WHEN CS.ANO_MES >= TO_CHAR(ADD_MONTHS(J.FIM, -5), 'YYYY-MM') THEN CS.QTD ELSE 0 END) AS QTD_6M\n    FROM cons_mes CS\n    CROSS JOIN jan2 J\n    GROUP BY CS.CODPROD\n),\nest AS (\n    SELECT ES0.CODPROD, SUM(NVL(ES0.QTD_ESTOQUE, 0)) AS QTD\n    FROM (SELECT\n    E.CODPROD                         AS CODPROD,\n    E.CODEMP                          AS CODEMP,\n    SUM(NVL(E.ESTOQUE, 0))            AS QTD_ESTOQUE,\n    SUM(NVL(E.RESERVADO, 0))          AS QTD_RESERVADO,\n    SUM(NVL(E.WMSBLOQUEADO, 0))       AS QTD_BLOQUEADO\nFROM TGFEST E\nWHERE E.CODLOCAL NOT IN (1030000, 2030000)\nGROUP BY E.CODPROD, E.CODEMP) ES0\n    CROSS JOIN prm PR\n    WHERE (PR.CODEMP = 0 OR ES0.CODEMP = PR.CODEMP)\n    GROUP BY ES0.CODPROD\n),\nemp AS (\n    SELECT EM0.CODPROD, SUM(NVL(EM0.QTD_EMPENHADA, 0)) AS QTD\n    FROM (SELECT\n    X.CODPROD                                     AS CODPROD,\n    X.CODEMP                                      AS CODEMP,\n    SUM(X.QTD_ABERTA * NVL(X.FATOR, 1))           AS QTD_EMPENHADA,\n    SUM(X.QTD_ABERTA * X.VLRUNIT)                 AS VLR_EMPENHADO,\n    SUM(CASE WHEN X.FATOR IS NULL THEN 1 ELSE 0 END) AS ITENS_SEM_CONVERSAO\nFROM (\n    SELECT\n        I.CODPROD, C.CODEMP, NVL(I.VLRUNIT, 0) AS VLRUNIT,\n        GREATEST(NVL(I.QTDNEG, 0) - NVL(I.QTDENTREGUE, 0) - NVL(I.QTDCONFERIDA, 0), 0) AS QTD_ABERTA,\n        CASE WHEN I.CODVOL = P.CODVOL THEN 1\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n        END AS FATOR\n    FROM TGFCAB C\n    JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'EMPENHO'\n    JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n    JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n    LEFT JOIN (\n        SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n               COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n        FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n    ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n    WHERE I.PENDENTE = 'S'\n      AND NVL(I.CANCELADO, 'N') <> 'S'\n) X\nWHERE X.QTD_ABERTA > 0\nGROUP BY X.CODPROD, X.CODEMP) EM0\n    CROSS JOIN prm PR\n    WHERE (PR.CODEMP = 0 OR EM0.CODEMP = PR.CODEMP)\n    GROUP BY EM0.CODPROD\n),\nocx AS (\n    SELECT OX.CODPROD, OX.NUNOTA, OX.SEQUENCIA, OX.CODEMP, OX.STATUS_OC, OX.QTD_PENDENTE,\n           OX.VLR_UNIT, OX.DT_NEGOCIACAO\n    FROM (SELECT\n    Z.NUNOTA, Z.SEQUENCIA, Z.CODEMP, Z.CODPARC, Z.FORNECEDOR, Z.CODTIPOPER, Z.DESCRICAO_TOP,\n    Z.CODPROD, Z.OS,\n    Z.QTDNEG * NVL(Z.FATOR, 1)                                       AS QTD_NEGOCIADA,\n    Z.QTDENTREGUE * NVL(Z.FATOR, 1)                                  AS QTD_ENTREGUE,\n    CASE WHEN Z.ABERTA = 1 THEN (Z.QTDNEG - Z.QTDENTREGUE) * NVL(Z.FATOR, 1) ELSE 0 END AS QTD_PENDENTE,\n    CASE WHEN Z.QTDNEG * NVL(Z.FATOR, 1) > 0 THEN Z.VLRTOT / (Z.QTDNEG * NVL(Z.FATOR, 1)) ELSE 0 END AS VLR_UNIT,\n    Z.VLRTOT                                                         AS VLR_TOTAL,\n    Z.DT_NEGOCIACAO,\n    Z.DT_ENTREGA_PREVISTA,\n    Z.PREVISAO_ORIGEM,\n    NVL(Z.DT_LIBERACAO, CASE WHEN Z.STATUSNOTA = 'L' THEN Z.DT_NEGOCIACAO END) AS DT_APROVACAO,\n    Z.DT_ENTREGA_REAL,\n    CASE WHEN Z.CANCELADO = 'S'                              THEN 'CANCELADA'\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG     THEN 'ENTREGUE'\n         WHEN Z.PENDENTE = 'N' AND Z.QTDENTREGUE > 0         THEN 'ENCERRADA_PARCIAL'\n         WHEN Z.PENDENTE = 'N'                               THEN 'ENCERRADA_SEM_RECEBER'\n         WHEN Z.QTDENTREGUE > 0                              THEN 'ENTREGA_PARCIAL'\n         WHEN Z.STATUSNOTA = 'L'                             THEN 'APROVADA_NAO_ENTREGUE'\n         ELSE 'ABERTA_NAO_APROVADA'\n    END                                                              AS STATUS_OC,\n    CASE WHEN Z.ABERTA = 1 AND Z.DT_ENTREGA_PREVISTA < TRUNC(SYSDATE)\n              THEN TRUNC(SYSDATE) - Z.DT_ENTREGA_PREVISTA\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG\n              AND Z.DT_ENTREGA_REAL IS NOT NULL AND Z.DT_ENTREGA_PREVISTA IS NOT NULL\n              THEN Z.DT_ENTREGA_REAL - Z.DT_ENTREGA_PREVISTA\n         ELSE 0\n    END                                                              AS DIAS_ATRASO,\n    CASE WHEN Z.FATOR IS NULL THEN 1 ELSE 0 END                      AS FL_SEM_CONVERSAO\nFROM (\n    SELECT Y.*,\n        CASE WHEN Y.CANCELADO <> 'S' AND Y.PENDENTE = 'S' AND Y.QTDENTREGUE < Y.QTDNEG THEN 1 ELSE 0 END AS ABERTA,\n        CASE WHEN Y.QTDENTREGUE > 0 THEN COALESCE(\n            (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFVAR V JOIN TGFCAB N ON N.NUNOTA = V.NUNOTA\n              WHERE V.NUNOTAORIG = Y.NUNOTA AND V.SEQUENCIAORIG = Y.SEQUENCIA AND V.NUNOTA <> Y.NUNOTA),\n            CASE WHEN Y.OS IS NOT NULL THEN\n                (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFITE E JOIN TGFCAB N ON N.NUNOTA = E.NUNOTA\n                  WHERE N.CODTIPOPER IN (259, 200) AND N.STATUSNOTA = 'L'\n                    AND TRIM(E.AD_OS) = Y.OS AND E.CODPROD = Y.CODPROD\n                    AND N.DTNEG >= Y.DT_NEGOCIACAO - 365)\n            END)\n        END AS DT_ENTREGA_REAL\n    FROM (\n        SELECT\n            C.NUNOTA, I.SEQUENCIA, C.CODEMP, C.CODPARC, PA.NOMEPARC AS FORNECEDOR,\n            C.CODTIPOPER, T.DESCROPER AS DESCRICAO_TOP, I.CODPROD,\n            TRIM(C.AD_OSTUICIAL)                     AS OS,\n            C.STATUSNOTA, NVL(I.PENDENTE, 'S')       AS PENDENTE, NVL(I.CANCELADO, 'N') AS CANCELADO,\n            NVL(I.QTDNEG, 0)                         AS QTDNEG,\n            NVL(I.QTDENTREGUE, 0)                    AS QTDENTREGUE,\n            NVL(I.VLRTOT, 0)                         AS VLRTOT,\n            TRUNC(C.DTNEG)                           AS DT_NEGOCIACAO,\n            COALESCE(TRUNC(C.DTPREVENT), TRUNC(C.DTNEG) + CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END) AS DT_ENTREGA_PREVISTA,\n            CASE WHEN C.DTPREVENT IS NOT NULL THEN 'DTPREVENT'\n                 WHEN P.LEADTIME > 0 THEN 'OC+LEADTIME' END AS PREVISAO_ORIGEM,\n            (SELECT TRUNC(MAX(L.DHLIB)) FROM TSILIB L\n              WHERE L.TABELA = 'TGFCAB' AND L.NUCHAVE = C.NUNOTA\n                AND L.DHLIB IS NOT NULL AND NVL(L.REPROVADO, 'N') <> 'S') AS DT_LIBERACAO,\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END                                      AS FATOR\n        FROM TGFCAB C\n        JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'ORDEM_COMPRA'\n        JOIN TGFTOP T ON T.CODTIPOPER = C.CODTIPOPER AND T.DHALTER = C.DHTIPOPER\n        JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n        JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n        LEFT JOIN TGFPAR PA ON PA.CODPARC = C.CODPARC\n        LEFT JOIN (\n            SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n                   COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n            FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n        ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n        WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -24)\n    ) Y\n) Z) OX\n),\nocab AS (\n    SELECT OA0.CODPROD, SUM(OA0.QTD_PENDENTE) AS QTD, COUNT(DISTINCT OA0.NUNOTA) AS N_OCS\n    FROM ocx OA0\n    CROSS JOIN prm PR\n    WHERE OA0.STATUS_OC IN ('ABERTA_NAO_APROVADA', 'APROVADA_NAO_ENTREGUE', 'ENTREGA_PARCIAL')\n      AND OA0.QTD_PENDENTE > 0\n      AND (PR.CODEMP = 0 OR OA0.CODEMP = PR.CODEMP)\n    GROUP BY OA0.CODPROD\n),\ncusto AS (\n    SELECT CU0.CODPROD, CU0.VLR_UNIT\n    FROM (\n        SELECT CX.CODPROD, CX.VLR_UNIT,\n               ROW_NUMBER() OVER (PARTITION BY CX.CODPROD\n                                  ORDER BY CX.DT_NEGOCIACAO DESC, CX.NUNOTA DESC, CX.SEQUENCIA DESC) AS RN\n        FROM ocx CX\n        WHERE CX.VLR_UNIT > 0 AND CX.STATUS_OC <> 'CANCELADA'\n    ) CU0\n    WHERE CU0.RN = 1\n),\nbase AS (\n    SELECT\n        PD.CODPROD, PD.DESCRPROD, PD.UNIDADE, PD.GRUPO, PD.GRUPO_DESCR, PD.CURVA_ABC,\n        PD.MULTIPLO_COMPRA, PD.LOTE_MINIMO, PD.ESTOQUE_MIN_PARAM,\n        NVL(PD.FL_SOB_ENCOMENDA, 0) AS FL_SOB_ENCOMENDA,\n        NVL(PD.FL_CONSIGNADO, 0) AS FL_CONSIGNADO,\n        NVL(ES.QTD, 0) AS QTD_ESTOQUE,\n        NVL(EM.QTD, 0) AS QTD_EMPENHADA,\n        NVL(ES.QTD, 0) - NVL(EM.QTD, 0) AS QTD_DISPONIVEL,\n        NVL(OA.QTD, 0) AS QTD_PENDENTE,\n        NVL(OA.N_OCS, 0) AS N_OCS_ABERTAS,\n        NVL(CU.VLR_UNIT, 0) AS VLR_UNIT,\n        CASE WHEN PD.LEADTIME_PARAM_DIAS > 0 THEN PD.LEADTIME_PARAM_DIAS ELSE PR.LT_PADRAO END AS LEADTIME,\n        CASE WHEN PD.LEADTIME_PARAM_DIAS > 0 THEN 0 ELSE 1 END AS FL_LT_PADRAO,\n        NVL(CO.QTD_JANELA, 0) AS QTD_JANELA,\n        NVL(CO.QTD_3M, 0) AS QTD_3M,\n        GREATEST(0, NVL(CO.QTD_JANELA, 0) / DV.DIVISOR) AS MEDIA_SIMPLES,\n        GREATEST(0, 0.5 * NVL(CO.QTD_3M, 0) / 3 + 0.3 * NVL(CO.QTD_6M, 0) / 6\n                    + 0.2 * NVL(CO.QTD_JANELA, 0) / DV.DIVISOR) AS MEDIA_PONDERADA,\n        CASE UPPER(NVL(PD.CURVA_ABC, 'C')) WHEN 'A' THEN PR.COB_A WHEN 'B' THEN PR.COB_B ELSE PR.COB_C END AS COB_ALVO,\n        PR.MEDIA_MODO, PR.DIAS_MES, PR.MARGEM, PR.COB_MAX, PR.SEG_FRAC\n    FROM (SELECT\n    P.CODPROD                                                AS CODPROD,\n    P.DESCRPROD                                              AS DESCRPROD,\n    P.REFERENCIA                                             AS REFERENCIA,\n    P.CODVOL                                                 AS UNIDADE,\n    P.MARCA                                                  AS MARCA,\n    P.CODGRUPOPROD                                           AS GRUPO,\n    G.DESCRGRUPOPROD                                         AS GRUPO_DESCR,\n    CASE WHEN P.ATIVO = 'S' THEN 1 ELSE 0 END                AS FL_ATIVO,\n    CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END             AS LEADTIME_PARAM_DIAS,\n    CASE WHEN P.ESTMIN > 0 THEN P.ESTMIN END                 AS ESTOQUE_MIN_PARAM,\n    CAST(NULL AS VARCHAR2(1))                                AS CURVA_ABC,\n    CASE WHEN P.AGRUPMIN > 1 THEN P.AGRUPMIN END             AS MULTIPLO_COMPRA,\n    CASE WHEN P.LOTECOMPMINIMO > 0 THEN P.LOTECOMPMINIMO END AS LOTE_MINIMO,\n    0                                                        AS FL_SOB_ENCOMENDA,\n    CASE WHEN NVL(P.CODPARCCONSIG, 0) > 0 THEN 1 ELSE 0 END  AS FL_CONSIGNADO\nFROM TGFPRO P\nLEFT JOIN TGFGRU G ON G.CODGRUPOPROD = P.CODGRUPOPROD) PD\n    CROSS JOIN prm PR\n    CROSS JOIN dvs DV\n    LEFT JOIN est ES ON ES.CODPROD = PD.CODPROD\n    LEFT JOIN emp EM ON EM.CODPROD = PD.CODPROD\n    LEFT JOIN ocab OA ON OA.CODPROD = PD.CODPROD\n    LEFT JOIN custo CU ON CU.CODPROD = PD.CODPROD\n    LEFT JOIN cons CO ON CO.CODPROD = PD.CODPROD\n    WHERE PD.FL_ATIVO = 1\n),\nmed AS (\n    SELECT BA.*,\n           CASE WHEN BA.MEDIA_MODO = 1 THEN BA.MEDIA_PONDERADA ELSE BA.MEDIA_SIMPLES END AS MEDIA_USADA\n    FROM base BA\n),\ndem AS (\n    SELECT ME.*, ME.MEDIA_USADA / ME.DIAS_MES AS DEMANDA_DIARIA FROM med ME\n),\ncob AS (\n    SELECT DE.*,\n        CASE WHEN DE.DEMANDA_DIARIA > 0 THEN DE.QTD_DISPONIVEL / DE.DEMANDA_DIARIA ELSE 999 END AS DIAS_EST_ATUAL,\n        CASE WHEN DE.DEMANDA_DIARIA > 0 THEN (DE.QTD_DISPONIVEL + DE.QTD_PENDENTE) / DE.DEMANDA_DIARIA ELSE 999 END AS DIAS_EST,\n        DE.DEMANDA_DIARIA * DE.LEADTIME * (1 + DE.SEG_FRAC) AS EST_MIN_CALC,\n        CASE WHEN DE.QTD_DISPONIVEL < 0 THEN -DE.QTD_DISPONIVEL * DE.VLR_UNIT ELSE 0 END AS RUPTURA_VALOR,\n        CASE WHEN DE.FL_SOB_ENCOMENDA = 1 OR DE.FL_CONSIGNADO = 1 OR DE.QTD_JANELA <= 0 THEN 0\n             ELSE GREATEST(0, DE.DEMANDA_DIARIA * (DE.LEADTIME + DE.COB_ALVO)\n                              - (DE.QTD_DISPONIVEL + DE.QTD_PENDENTE)) END AS QTD_BRUTA\n    FROM dem DE\n),\nmult AS (\n    SELECT CB.*,\n        CASE WHEN CB.QTD_BRUTA <= 0 THEN 0\n             WHEN NVL(CB.MULTIPLO_COMPRA, 0) > 0 THEN CEIL(CB.QTD_BRUTA / CB.MULTIPLO_COMPRA) * CB.MULTIPLO_COMPRA\n             ELSE CEIL(CB.QTD_BRUTA) END AS QTD_MULT\n    FROM cob CB\n),\nsop AS (\n    SELECT MU.*,\n        CASE WHEN MU.QTD_MULT > 0 AND NVL(MU.LOTE_MINIMO, 0) > MU.QTD_MULT\n             THEN CASE WHEN NVL(MU.MULTIPLO_COMPRA, 0) > 0\n                       THEN CEIL(MU.LOTE_MINIMO / MU.MULTIPLO_COMPRA) * MU.MULTIPLO_COMPRA\n                       ELSE MU.LOTE_MINIMO END\n             ELSE MU.QTD_MULT END AS QTD_SUGERIDA,\n        CASE WHEN MU.QTD_DISPONIVEL < 0 OR (MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST <= 0) THEN 'P1_CRITICO'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME               THEN 'P2_RUPTURA_IMINENTE'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME + MU.MARGEM   THEN 'P3_ATENCAO'\n             WHEN MU.QTD_ESTOQUE > 0 AND MU.QTD_JANELA <= 0                         THEN 'P0_EXCESSO_SEM_GIRO'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST > MU.COB_MAX                THEN 'P0_EXCESSO'\n             ELSE 'OK' END AS PRIORIDADE,\n        CASE WHEN MU.QTD_DISPONIVEL < 0                                             THEN 'RUPTURA'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME               THEN 'PONTO_PEDIDO'\n             WHEN MU.ESTOQUE_MIN_PARAM > 0 AND MU.QTD_DISPONIVEL < MU.ESTOQUE_MIN_PARAM THEN 'MINIMO_CURVA_A'\n             ELSE 'SEM_DISPARO' END AS REGRA_DISPARO\n    FROM mult MU\n),\nnc AS (\n    SELECT S.* FROM sop S WHERE S.QTD_PENDENTE > 0 AND S.QTD_SUGERIDA > 0\n)\nSELECT N.CODPROD, N.DESCRPROD, N.UNIDADE, N.PRIORIDADE,\n       ROUND(N.QTD_PENDENTE, 2)                        AS QTD_PENDENTE,\n       N.QTD_SUGERIDA,\n       ROUND(N.QTD_SUGERIDA * N.VLR_UNIT, 2)           AS VLR_FALTANTE,\n       N.N_OCS_ABERTAS,\n       COUNT(*) OVER ()                                AS TOTAL_SKUS,\n       ROUND(SUM(N.QTD_SUGERIDA * N.VLR_UNIT) OVER (), 2) AS TOTAL_VLR,\n       (SELECT COUNT(DISTINCT OY.NUNOTA)\n          FROM ocx OY CROSS JOIN prm PR2\n         WHERE OY.STATUS_OC IN ('ABERTA_NAO_APROVADA', 'APROVADA_NAO_ENTREGUE', 'ENTREGA_PARCIAL')\n           AND OY.QTD_PENDENTE > 0\n           AND (PR2.CODEMP = 0 OR OY.CODEMP = PR2.CODEMP)\n           AND OY.CODPROD IN (SELECT N2.CODPROD FROM nc N2))  AS N_OCS_ENVOLVIDAS\nFROM nc N\nORDER BY CASE N.PRIORIDADE WHEN 'P1_CRITICO' THEN 1 WHEN 'P2_RUPTURA_IMINENTE' THEN 2\n                           WHEN 'P3_ATENCAO' THEN 3 ELSE 4 END,\n         N.QTD_SUGERIDA * N.VLR_UNIT DESC, N.CODPROD\nFETCH FIRST ? ROWS ONLY","params":["CODEMP","DIAS_MES_X10000","MARGEM_ATENCAO_DIAS","COBERTURA_MAX_DIAS","SEGURANCA_X10000","COBERTURA_ALVO_A","COBERTURA_ALVO_B","COBERTURA_ALVO_C","LEADTIME_DEFAULT","MEDIA_MODO","MESES_MEDIA","DIVISOR_MEDIA","INCLUI_MES_ATUAL","LIMITE_NAO_COBRE"],"tipos":["I","I","I","I","I","I","I","I","I","I","I","I","I","I"]},"Q_OC_KPIS":{"sql":"WITH prm AS (\n    SELECT TO_NUMBER(?) AS CODEMP, TO_DATE(?, 'YYYY-MM-DD') AS DT_INI, TO_DATE(?, 'YYYY-MM-DD') AS DT_FIM FROM DUAL\n),\noci AS (\n    SELECT O.NUNOTA, O.STATUS_OC, O.QTD_PENDENTE, O.VLR_UNIT, O.DIAS_ATRASO,\n           O.DT_ENTREGA_REAL, O.DT_ENTREGA_PREVISTA, O.PREVISAO_ORIGEM,\n           CASE WHEN O.STATUS_OC IN ('ABERTA_NAO_APROVADA', 'APROVADA_NAO_ENTREGUE', 'ENTREGA_PARCIAL')\n                 AND O.QTD_PENDENTE > 0 THEN 1 ELSE 0 END AS FL_ABERTA\n    FROM (SELECT\n    Z.NUNOTA, Z.SEQUENCIA, Z.CODEMP, Z.CODPARC, Z.FORNECEDOR, Z.CODTIPOPER, Z.DESCRICAO_TOP,\n    Z.CODPROD, Z.OS,\n    Z.QTDNEG * NVL(Z.FATOR, 1)                                       AS QTD_NEGOCIADA,\n    Z.QTDENTREGUE * NVL(Z.FATOR, 1)                                  AS QTD_ENTREGUE,\n    CASE WHEN Z.ABERTA = 1 THEN (Z.QTDNEG - Z.QTDENTREGUE) * NVL(Z.FATOR, 1) ELSE 0 END AS QTD_PENDENTE,\n    CASE WHEN Z.QTDNEG * NVL(Z.FATOR, 1) > 0 THEN Z.VLRTOT / (Z.QTDNEG * NVL(Z.FATOR, 1)) ELSE 0 END AS VLR_UNIT,\n    Z.VLRTOT                                                         AS VLR_TOTAL,\n    Z.DT_NEGOCIACAO,\n    Z.DT_ENTREGA_PREVISTA,\n    Z.PREVISAO_ORIGEM,\n    NVL(Z.DT_LIBERACAO, CASE WHEN Z.STATUSNOTA = 'L' THEN Z.DT_NEGOCIACAO END) AS DT_APROVACAO,\n    Z.DT_ENTREGA_REAL,\n    CASE WHEN Z.CANCELADO = 'S'                              THEN 'CANCELADA'\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG     THEN 'ENTREGUE'\n         WHEN Z.PENDENTE = 'N' AND Z.QTDENTREGUE > 0         THEN 'ENCERRADA_PARCIAL'\n         WHEN Z.PENDENTE = 'N'                               THEN 'ENCERRADA_SEM_RECEBER'\n         WHEN Z.QTDENTREGUE > 0                              THEN 'ENTREGA_PARCIAL'\n         WHEN Z.STATUSNOTA = 'L'                             THEN 'APROVADA_NAO_ENTREGUE'\n         ELSE 'ABERTA_NAO_APROVADA'\n    END                                                              AS STATUS_OC,\n    CASE WHEN Z.ABERTA = 1 AND Z.DT_ENTREGA_PREVISTA < TRUNC(SYSDATE)\n              THEN TRUNC(SYSDATE) - Z.DT_ENTREGA_PREVISTA\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG\n              AND Z.DT_ENTREGA_REAL IS NOT NULL AND Z.DT_ENTREGA_PREVISTA IS NOT NULL\n              THEN Z.DT_ENTREGA_REAL - Z.DT_ENTREGA_PREVISTA\n         ELSE 0\n    END                                                              AS DIAS_ATRASO,\n    CASE WHEN Z.FATOR IS NULL THEN 1 ELSE 0 END                      AS FL_SEM_CONVERSAO\nFROM (\n    SELECT Y.*,\n        CASE WHEN Y.CANCELADO <> 'S' AND Y.PENDENTE = 'S' AND Y.QTDENTREGUE < Y.QTDNEG THEN 1 ELSE 0 END AS ABERTA,\n        CASE WHEN Y.QTDENTREGUE > 0 THEN COALESCE(\n            (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFVAR V JOIN TGFCAB N ON N.NUNOTA = V.NUNOTA\n              WHERE V.NUNOTAORIG = Y.NUNOTA AND V.SEQUENCIAORIG = Y.SEQUENCIA AND V.NUNOTA <> Y.NUNOTA),\n            CASE WHEN Y.OS IS NOT NULL THEN\n                (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFITE E JOIN TGFCAB N ON N.NUNOTA = E.NUNOTA\n                  WHERE N.CODTIPOPER IN (259, 200) AND N.STATUSNOTA = 'L'\n                    AND TRIM(E.AD_OS) = Y.OS AND E.CODPROD = Y.CODPROD\n                    AND N.DTNEG >= Y.DT_NEGOCIACAO - 365)\n            END)\n        END AS DT_ENTREGA_REAL\n    FROM (\n        SELECT\n            C.NUNOTA, I.SEQUENCIA, C.CODEMP, C.CODPARC, PA.NOMEPARC AS FORNECEDOR,\n            C.CODTIPOPER, T.DESCROPER AS DESCRICAO_TOP, I.CODPROD,\n            TRIM(C.AD_OSTUICIAL)                     AS OS,\n            C.STATUSNOTA, NVL(I.PENDENTE, 'S')       AS PENDENTE, NVL(I.CANCELADO, 'N') AS CANCELADO,\n            NVL(I.QTDNEG, 0)                         AS QTDNEG,\n            NVL(I.QTDENTREGUE, 0)                    AS QTDENTREGUE,\n            NVL(I.VLRTOT, 0)                         AS VLRTOT,\n            TRUNC(C.DTNEG)                           AS DT_NEGOCIACAO,\n            COALESCE(TRUNC(C.DTPREVENT), TRUNC(C.DTNEG) + CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END) AS DT_ENTREGA_PREVISTA,\n            CASE WHEN C.DTPREVENT IS NOT NULL THEN 'DTPREVENT'\n                 WHEN P.LEADTIME > 0 THEN 'OC+LEADTIME' END AS PREVISAO_ORIGEM,\n            (SELECT TRUNC(MAX(L.DHLIB)) FROM TSILIB L\n              WHERE L.TABELA = 'TGFCAB' AND L.NUCHAVE = C.NUNOTA\n                AND L.DHLIB IS NOT NULL AND NVL(L.REPROVADO, 'N') <> 'S') AS DT_LIBERACAO,\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END                                      AS FATOR\n        FROM TGFCAB C\n        JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'ORDEM_COMPRA'\n        JOIN TGFTOP T ON T.CODTIPOPER = C.CODTIPOPER AND T.DHALTER = C.DHTIPOPER\n        JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n        JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n        LEFT JOIN TGFPAR PA ON PA.CODPARC = C.CODPARC\n        LEFT JOIN (\n            SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n                   COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n            FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n        ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n        WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -24)\n    ) Y\n) Z) O\n    CROSS JOIN prm PR\n    WHERE (PR.CODEMP = 0 OR O.CODEMP = PR.CODEMP)\n)\nSELECT\n    COUNT(DISTINCT CASE WHEN OI.FL_ABERTA = 1 THEN OI.NUNOTA END)                          AS OCS_ABERTAS,\n    COUNT(DISTINCT CASE WHEN OI.FL_ABERTA = 1 AND OI.DIAS_ATRASO > 0 THEN OI.NUNOTA END)   AS OCS_ATRASO,\n    ROUND(SUM(CASE WHEN OI.FL_ABERTA = 1 THEN OI.QTD_PENDENTE * OI.VLR_UNIT ELSE 0 END), 2) AS VLR_TRANSITO,\n    SUM(CASE WHEN OI.STATUS_OC = 'ENTREGUE' AND OI.DT_ENTREGA_REAL >= PR.DT_INI\n              AND OI.DT_ENTREGA_REAL < PR.DT_FIM + 1 THEN 1 ELSE 0 END)                    AS ENTREGAS,\n    SUM(CASE WHEN OI.STATUS_OC = 'ENTREGUE' AND OI.DT_ENTREGA_REAL >= PR.DT_INI\n              AND OI.DT_ENTREGA_REAL < PR.DT_FIM + 1 AND OI.DIAS_ATRASO <= 0 THEN 1 ELSE 0 END) AS ENTREGAS_NO_PRAZO,\n    SUM(CASE WHEN OI.STATUS_OC = 'ENTREGUE' AND OI.DT_ENTREGA_REAL IS NULL THEN 1 ELSE 0 END) AS ENTREGUES_SEM_DATA,\n    SUM(CASE WHEN OI.FL_ABERTA = 1 AND OI.DT_ENTREGA_PREVISTA IS NULL THEN 1 ELSE 0 END)   AS ABERTAS_SEM_PREVISAO,\n    SUM(CASE WHEN OI.FL_ABERTA = 1 AND OI.PREVISAO_ORIGEM = 'OC+LEADTIME' THEN 1 ELSE 0 END) AS ABERTAS_PREV_ESTIMADA,\n    SUM(OI.FL_ABERTA)                                                                       AS ITENS_ABERTOS,\n    MAX(TO_CHAR(SYSDATE, 'DD/MM/YYYY HH24:MI'))                                             AS SNAPSHOT\nFROM oci OI\nCROSS JOIN prm PR","params":["CODEMP","DT_INI","DT_FIM"],"tipos":["I","S","S"]},"Q_FUNIL":{"sql":"WITH prm AS (\n    SELECT TO_NUMBER(?) AS CODEMP, TO_DATE(?, 'YYYY-MM-DD') AS DT_INI, TO_DATE(?, 'YYYY-MM-DD') AS DT_FIM FROM DUAL\n),\nper AS (\n    SELECT O.NUNOTA, O.STATUS_OC, O.VLR_TOTAL\n    FROM (SELECT\n    Z.NUNOTA, Z.SEQUENCIA, Z.CODEMP, Z.CODPARC, Z.FORNECEDOR, Z.CODTIPOPER, Z.DESCRICAO_TOP,\n    Z.CODPROD, Z.OS,\n    Z.QTDNEG * NVL(Z.FATOR, 1)                                       AS QTD_NEGOCIADA,\n    Z.QTDENTREGUE * NVL(Z.FATOR, 1)                                  AS QTD_ENTREGUE,\n    CASE WHEN Z.ABERTA = 1 THEN (Z.QTDNEG - Z.QTDENTREGUE) * NVL(Z.FATOR, 1) ELSE 0 END AS QTD_PENDENTE,\n    CASE WHEN Z.QTDNEG * NVL(Z.FATOR, 1) > 0 THEN Z.VLRTOT / (Z.QTDNEG * NVL(Z.FATOR, 1)) ELSE 0 END AS VLR_UNIT,\n    Z.VLRTOT                                                         AS VLR_TOTAL,\n    Z.DT_NEGOCIACAO,\n    Z.DT_ENTREGA_PREVISTA,\n    Z.PREVISAO_ORIGEM,\n    NVL(Z.DT_LIBERACAO, CASE WHEN Z.STATUSNOTA = 'L' THEN Z.DT_NEGOCIACAO END) AS DT_APROVACAO,\n    Z.DT_ENTREGA_REAL,\n    CASE WHEN Z.CANCELADO = 'S'                              THEN 'CANCELADA'\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG     THEN 'ENTREGUE'\n         WHEN Z.PENDENTE = 'N' AND Z.QTDENTREGUE > 0         THEN 'ENCERRADA_PARCIAL'\n         WHEN Z.PENDENTE = 'N'                               THEN 'ENCERRADA_SEM_RECEBER'\n         WHEN Z.QTDENTREGUE > 0                              THEN 'ENTREGA_PARCIAL'\n         WHEN Z.STATUSNOTA = 'L'                             THEN 'APROVADA_NAO_ENTREGUE'\n         ELSE 'ABERTA_NAO_APROVADA'\n    END                                                              AS STATUS_OC,\n    CASE WHEN Z.ABERTA = 1 AND Z.DT_ENTREGA_PREVISTA < TRUNC(SYSDATE)\n              THEN TRUNC(SYSDATE) - Z.DT_ENTREGA_PREVISTA\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG\n              AND Z.DT_ENTREGA_REAL IS NOT NULL AND Z.DT_ENTREGA_PREVISTA IS NOT NULL\n              THEN Z.DT_ENTREGA_REAL - Z.DT_ENTREGA_PREVISTA\n         ELSE 0\n    END                                                              AS DIAS_ATRASO,\n    CASE WHEN Z.FATOR IS NULL THEN 1 ELSE 0 END                      AS FL_SEM_CONVERSAO\nFROM (\n    SELECT Y.*,\n        CASE WHEN Y.CANCELADO <> 'S' AND Y.PENDENTE = 'S' AND Y.QTDENTREGUE < Y.QTDNEG THEN 1 ELSE 0 END AS ABERTA,\n        CASE WHEN Y.QTDENTREGUE > 0 THEN COALESCE(\n            (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFVAR V JOIN TGFCAB N ON N.NUNOTA = V.NUNOTA\n              WHERE V.NUNOTAORIG = Y.NUNOTA AND V.SEQUENCIAORIG = Y.SEQUENCIA AND V.NUNOTA <> Y.NUNOTA),\n            CASE WHEN Y.OS IS NOT NULL THEN\n                (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFITE E JOIN TGFCAB N ON N.NUNOTA = E.NUNOTA\n                  WHERE N.CODTIPOPER IN (259, 200) AND N.STATUSNOTA = 'L'\n                    AND TRIM(E.AD_OS) = Y.OS AND E.CODPROD = Y.CODPROD\n                    AND N.DTNEG >= Y.DT_NEGOCIACAO - 365)\n            END)\n        END AS DT_ENTREGA_REAL\n    FROM (\n        SELECT\n            C.NUNOTA, I.SEQUENCIA, C.CODEMP, C.CODPARC, PA.NOMEPARC AS FORNECEDOR,\n            C.CODTIPOPER, T.DESCROPER AS DESCRICAO_TOP, I.CODPROD,\n            TRIM(C.AD_OSTUICIAL)                     AS OS,\n            C.STATUSNOTA, NVL(I.PENDENTE, 'S')       AS PENDENTE, NVL(I.CANCELADO, 'N') AS CANCELADO,\n            NVL(I.QTDNEG, 0)                         AS QTDNEG,\n            NVL(I.QTDENTREGUE, 0)                    AS QTDENTREGUE,\n            NVL(I.VLRTOT, 0)                         AS VLRTOT,\n            TRUNC(C.DTNEG)                           AS DT_NEGOCIACAO,\n            COALESCE(TRUNC(C.DTPREVENT), TRUNC(C.DTNEG) + CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END) AS DT_ENTREGA_PREVISTA,\n            CASE WHEN C.DTPREVENT IS NOT NULL THEN 'DTPREVENT'\n                 WHEN P.LEADTIME > 0 THEN 'OC+LEADTIME' END AS PREVISAO_ORIGEM,\n            (SELECT TRUNC(MAX(L.DHLIB)) FROM TSILIB L\n              WHERE L.TABELA = 'TGFCAB' AND L.NUCHAVE = C.NUNOTA\n                AND L.DHLIB IS NOT NULL AND NVL(L.REPROVADO, 'N') <> 'S') AS DT_LIBERACAO,\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END                                      AS FATOR\n        FROM TGFCAB C\n        JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'ORDEM_COMPRA'\n        JOIN TGFTOP T ON T.CODTIPOPER = C.CODTIPOPER AND T.DHALTER = C.DHTIPOPER\n        JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n        JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n        LEFT JOIN TGFPAR PA ON PA.CODPARC = C.CODPARC\n        LEFT JOIN (\n            SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n                   COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n            FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n        ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n        WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -24)\n    ) Y\n) Z) O\n    CROSS JOIN prm PR\n    WHERE O.DT_NEGOCIACAO >= PR.DT_INI AND O.DT_NEGOCIACAO < PR.DT_FIM + 1\n      AND (PR.CODEMP = 0 OR O.CODEMP = PR.CODEMP)\n)\nSELECT PE.STATUS_OC,\n       COUNT(DISTINCT PE.NUNOTA)           AS N_OCS,\n       COUNT(*)                            AS N_ITENS,\n       ROUND(SUM(PE.VLR_TOTAL), 2)         AS VLR_TOTAL,\n       (SELECT COUNT(DISTINCT P2.NUNOTA) FROM per P2) AS N_OCS_PERIODO\nFROM per PE\nGROUP BY PE.STATUS_OC","params":["CODEMP","DT_INI","DT_FIM"],"tipos":["I","S","S"]},"Q_AGING":{"sql":"WITH prm AS (\n    SELECT TO_NUMBER(?) AS CODEMP FROM DUAL\n),\nab AS (\n    SELECT O.NUNOTA, O.QTD_PENDENTE * O.VLR_UNIT AS VLR, TRUNC(SYSDATE) - O.DT_NEGOCIACAO AS IDADE\n    FROM (SELECT\n    Z.NUNOTA, Z.SEQUENCIA, Z.CODEMP, Z.CODPARC, Z.FORNECEDOR, Z.CODTIPOPER, Z.DESCRICAO_TOP,\n    Z.CODPROD, Z.OS,\n    Z.QTDNEG * NVL(Z.FATOR, 1)                                       AS QTD_NEGOCIADA,\n    Z.QTDENTREGUE * NVL(Z.FATOR, 1)                                  AS QTD_ENTREGUE,\n    CASE WHEN Z.ABERTA = 1 THEN (Z.QTDNEG - Z.QTDENTREGUE) * NVL(Z.FATOR, 1) ELSE 0 END AS QTD_PENDENTE,\n    CASE WHEN Z.QTDNEG * NVL(Z.FATOR, 1) > 0 THEN Z.VLRTOT / (Z.QTDNEG * NVL(Z.FATOR, 1)) ELSE 0 END AS VLR_UNIT,\n    Z.VLRTOT                                                         AS VLR_TOTAL,\n    Z.DT_NEGOCIACAO,\n    Z.DT_ENTREGA_PREVISTA,\n    Z.PREVISAO_ORIGEM,\n    NVL(Z.DT_LIBERACAO, CASE WHEN Z.STATUSNOTA = 'L' THEN Z.DT_NEGOCIACAO END) AS DT_APROVACAO,\n    Z.DT_ENTREGA_REAL,\n    CASE WHEN Z.CANCELADO = 'S'                              THEN 'CANCELADA'\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG     THEN 'ENTREGUE'\n         WHEN Z.PENDENTE = 'N' AND Z.QTDENTREGUE > 0         THEN 'ENCERRADA_PARCIAL'\n         WHEN Z.PENDENTE = 'N'                               THEN 'ENCERRADA_SEM_RECEBER'\n         WHEN Z.QTDENTREGUE > 0                              THEN 'ENTREGA_PARCIAL'\n         WHEN Z.STATUSNOTA = 'L'                             THEN 'APROVADA_NAO_ENTREGUE'\n         ELSE 'ABERTA_NAO_APROVADA'\n    END                                                              AS STATUS_OC,\n    CASE WHEN Z.ABERTA = 1 AND Z.DT_ENTREGA_PREVISTA < TRUNC(SYSDATE)\n              THEN TRUNC(SYSDATE) - Z.DT_ENTREGA_PREVISTA\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG\n              AND Z.DT_ENTREGA_REAL IS NOT NULL AND Z.DT_ENTREGA_PREVISTA IS NOT NULL\n              THEN Z.DT_ENTREGA_REAL - Z.DT_ENTREGA_PREVISTA\n         ELSE 0\n    END                                                              AS DIAS_ATRASO,\n    CASE WHEN Z.FATOR IS NULL THEN 1 ELSE 0 END                      AS FL_SEM_CONVERSAO\nFROM (\n    SELECT Y.*,\n        CASE WHEN Y.CANCELADO <> 'S' AND Y.PENDENTE = 'S' AND Y.QTDENTREGUE < Y.QTDNEG THEN 1 ELSE 0 END AS ABERTA,\n        CASE WHEN Y.QTDENTREGUE > 0 THEN COALESCE(\n            (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFVAR V JOIN TGFCAB N ON N.NUNOTA = V.NUNOTA\n              WHERE V.NUNOTAORIG = Y.NUNOTA AND V.SEQUENCIAORIG = Y.SEQUENCIA AND V.NUNOTA <> Y.NUNOTA),\n            CASE WHEN Y.OS IS NOT NULL THEN\n                (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFITE E JOIN TGFCAB N ON N.NUNOTA = E.NUNOTA\n                  WHERE N.CODTIPOPER IN (259, 200) AND N.STATUSNOTA = 'L'\n                    AND TRIM(E.AD_OS) = Y.OS AND E.CODPROD = Y.CODPROD\n                    AND N.DTNEG >= Y.DT_NEGOCIACAO - 365)\n            END)\n        END AS DT_ENTREGA_REAL\n    FROM (\n        SELECT\n            C.NUNOTA, I.SEQUENCIA, C.CODEMP, C.CODPARC, PA.NOMEPARC AS FORNECEDOR,\n            C.CODTIPOPER, T.DESCROPER AS DESCRICAO_TOP, I.CODPROD,\n            TRIM(C.AD_OSTUICIAL)                     AS OS,\n            C.STATUSNOTA, NVL(I.PENDENTE, 'S')       AS PENDENTE, NVL(I.CANCELADO, 'N') AS CANCELADO,\n            NVL(I.QTDNEG, 0)                         AS QTDNEG,\n            NVL(I.QTDENTREGUE, 0)                    AS QTDENTREGUE,\n            NVL(I.VLRTOT, 0)                         AS VLRTOT,\n            TRUNC(C.DTNEG)                           AS DT_NEGOCIACAO,\n            COALESCE(TRUNC(C.DTPREVENT), TRUNC(C.DTNEG) + CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END) AS DT_ENTREGA_PREVISTA,\n            CASE WHEN C.DTPREVENT IS NOT NULL THEN 'DTPREVENT'\n                 WHEN P.LEADTIME > 0 THEN 'OC+LEADTIME' END AS PREVISAO_ORIGEM,\n            (SELECT TRUNC(MAX(L.DHLIB)) FROM TSILIB L\n              WHERE L.TABELA = 'TGFCAB' AND L.NUCHAVE = C.NUNOTA\n                AND L.DHLIB IS NOT NULL AND NVL(L.REPROVADO, 'N') <> 'S') AS DT_LIBERACAO,\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END                                      AS FATOR\n        FROM TGFCAB C\n        JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'ORDEM_COMPRA'\n        JOIN TGFTOP T ON T.CODTIPOPER = C.CODTIPOPER AND T.DHALTER = C.DHTIPOPER\n        JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n        JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n        LEFT JOIN TGFPAR PA ON PA.CODPARC = C.CODPARC\n        LEFT JOIN (\n            SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n                   COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n            FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n        ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n        WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -24)\n    ) Y\n) Z) O\n    CROSS JOIN prm PR\n    WHERE O.STATUS_OC IN ('ABERTA_NAO_APROVADA', 'APROVADA_NAO_ENTREGUE', 'ENTREGA_PARCIAL')\n      AND O.QTD_PENDENTE > 0\n      AND (PR.CODEMP = 0 OR O.CODEMP = PR.CODEMP)\n),\nfx AS (\n    SELECT AB0.NUNOTA, AB0.VLR,\n           CASE WHEN AB0.IDADE <= 15 THEN 1 WHEN AB0.IDADE <= 30 THEN 2 WHEN AB0.IDADE <= 60 THEN 3 ELSE 4 END AS ORDEM\n    FROM ab AB0\n)\nSELECT FX0.ORDEM,\n       CASE FX0.ORDEM WHEN 1 THEN '0-15' WHEN 2 THEN '16-30' WHEN 3 THEN '31-60' ELSE '60+' END AS FAIXA,\n       COUNT(DISTINCT FX0.NUNOTA) AS N_OCS,\n       COUNT(*)                   AS N_ITENS,\n       ROUND(SUM(FX0.VLR), 2)     AS VLR_PENDENTE\nFROM fx FX0\nGROUP BY FX0.ORDEM\nORDER BY FX0.ORDEM","params":["CODEMP"],"tipos":["I"]},"Q_ATRASO":{"sql":"WITH prm AS (\n    SELECT TO_NUMBER(?) AS CODEMP FROM DUAL\n),\natr AS (\n    SELECT O.NUNOTA, O.SEQUENCIA, O.CODPROD, O.FORNECEDOR, O.QTD_PENDENTE, O.DT_ENTREGA_PREVISTA,\n           O.PREVISAO_ORIGEM, O.DIAS_ATRASO, O.STATUS_OC, O.QTD_PENDENTE * O.VLR_UNIT AS IMPACTO\n    FROM (SELECT\n    Z.NUNOTA, Z.SEQUENCIA, Z.CODEMP, Z.CODPARC, Z.FORNECEDOR, Z.CODTIPOPER, Z.DESCRICAO_TOP,\n    Z.CODPROD, Z.OS,\n    Z.QTDNEG * NVL(Z.FATOR, 1)                                       AS QTD_NEGOCIADA,\n    Z.QTDENTREGUE * NVL(Z.FATOR, 1)                                  AS QTD_ENTREGUE,\n    CASE WHEN Z.ABERTA = 1 THEN (Z.QTDNEG - Z.QTDENTREGUE) * NVL(Z.FATOR, 1) ELSE 0 END AS QTD_PENDENTE,\n    CASE WHEN Z.QTDNEG * NVL(Z.FATOR, 1) > 0 THEN Z.VLRTOT / (Z.QTDNEG * NVL(Z.FATOR, 1)) ELSE 0 END AS VLR_UNIT,\n    Z.VLRTOT                                                         AS VLR_TOTAL,\n    Z.DT_NEGOCIACAO,\n    Z.DT_ENTREGA_PREVISTA,\n    Z.PREVISAO_ORIGEM,\n    NVL(Z.DT_LIBERACAO, CASE WHEN Z.STATUSNOTA = 'L' THEN Z.DT_NEGOCIACAO END) AS DT_APROVACAO,\n    Z.DT_ENTREGA_REAL,\n    CASE WHEN Z.CANCELADO = 'S'                              THEN 'CANCELADA'\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG     THEN 'ENTREGUE'\n         WHEN Z.PENDENTE = 'N' AND Z.QTDENTREGUE > 0         THEN 'ENCERRADA_PARCIAL'\n         WHEN Z.PENDENTE = 'N'                               THEN 'ENCERRADA_SEM_RECEBER'\n         WHEN Z.QTDENTREGUE > 0                              THEN 'ENTREGA_PARCIAL'\n         WHEN Z.STATUSNOTA = 'L'                             THEN 'APROVADA_NAO_ENTREGUE'\n         ELSE 'ABERTA_NAO_APROVADA'\n    END                                                              AS STATUS_OC,\n    CASE WHEN Z.ABERTA = 1 AND Z.DT_ENTREGA_PREVISTA < TRUNC(SYSDATE)\n              THEN TRUNC(SYSDATE) - Z.DT_ENTREGA_PREVISTA\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG\n              AND Z.DT_ENTREGA_REAL IS NOT NULL AND Z.DT_ENTREGA_PREVISTA IS NOT NULL\n              THEN Z.DT_ENTREGA_REAL - Z.DT_ENTREGA_PREVISTA\n         ELSE 0\n    END                                                              AS DIAS_ATRASO,\n    CASE WHEN Z.FATOR IS NULL THEN 1 ELSE 0 END                      AS FL_SEM_CONVERSAO\nFROM (\n    SELECT Y.*,\n        CASE WHEN Y.CANCELADO <> 'S' AND Y.PENDENTE = 'S' AND Y.QTDENTREGUE < Y.QTDNEG THEN 1 ELSE 0 END AS ABERTA,\n        CASE WHEN Y.QTDENTREGUE > 0 THEN COALESCE(\n            (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFVAR V JOIN TGFCAB N ON N.NUNOTA = V.NUNOTA\n              WHERE V.NUNOTAORIG = Y.NUNOTA AND V.SEQUENCIAORIG = Y.SEQUENCIA AND V.NUNOTA <> Y.NUNOTA),\n            CASE WHEN Y.OS IS NOT NULL THEN\n                (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFITE E JOIN TGFCAB N ON N.NUNOTA = E.NUNOTA\n                  WHERE N.CODTIPOPER IN (259, 200) AND N.STATUSNOTA = 'L'\n                    AND TRIM(E.AD_OS) = Y.OS AND E.CODPROD = Y.CODPROD\n                    AND N.DTNEG >= Y.DT_NEGOCIACAO - 365)\n            END)\n        END AS DT_ENTREGA_REAL\n    FROM (\n        SELECT\n            C.NUNOTA, I.SEQUENCIA, C.CODEMP, C.CODPARC, PA.NOMEPARC AS FORNECEDOR,\n            C.CODTIPOPER, T.DESCROPER AS DESCRICAO_TOP, I.CODPROD,\n            TRIM(C.AD_OSTUICIAL)                     AS OS,\n            C.STATUSNOTA, NVL(I.PENDENTE, 'S')       AS PENDENTE, NVL(I.CANCELADO, 'N') AS CANCELADO,\n            NVL(I.QTDNEG, 0)                         AS QTDNEG,\n            NVL(I.QTDENTREGUE, 0)                    AS QTDENTREGUE,\n            NVL(I.VLRTOT, 0)                         AS VLRTOT,\n            TRUNC(C.DTNEG)                           AS DT_NEGOCIACAO,\n            COALESCE(TRUNC(C.DTPREVENT), TRUNC(C.DTNEG) + CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END) AS DT_ENTREGA_PREVISTA,\n            CASE WHEN C.DTPREVENT IS NOT NULL THEN 'DTPREVENT'\n                 WHEN P.LEADTIME > 0 THEN 'OC+LEADTIME' END AS PREVISAO_ORIGEM,\n            (SELECT TRUNC(MAX(L.DHLIB)) FROM TSILIB L\n              WHERE L.TABELA = 'TGFCAB' AND L.NUCHAVE = C.NUNOTA\n                AND L.DHLIB IS NOT NULL AND NVL(L.REPROVADO, 'N') <> 'S') AS DT_LIBERACAO,\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END                                      AS FATOR\n        FROM TGFCAB C\n        JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'ORDEM_COMPRA'\n        JOIN TGFTOP T ON T.CODTIPOPER = C.CODTIPOPER AND T.DHALTER = C.DHTIPOPER\n        JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n        JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n        LEFT JOIN TGFPAR PA ON PA.CODPARC = C.CODPARC\n        LEFT JOIN (\n            SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n                   COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n            FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n        ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n        WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -24)\n    ) Y\n) Z) O\n    CROSS JOIN prm PR\n    WHERE O.STATUS_OC IN ('ABERTA_NAO_APROVADA', 'APROVADA_NAO_ENTREGUE', 'ENTREGA_PARCIAL')\n      AND O.QTD_PENDENTE > 0\n      AND O.DIAS_ATRASO > 0\n      AND (PR.CODEMP = 0 OR O.CODEMP = PR.CODEMP)\n)\nSELECT A.NUNOTA, A.SEQUENCIA, A.CODPROD, PD.DESCRPROD, PD.UNIDADE, A.FORNECEDOR,\n       ROUND(A.QTD_PENDENTE, 2)                       AS QTD_PENDENTE,\n       TO_CHAR(A.DT_ENTREGA_PREVISTA, 'DD/MM/YYYY')   AS DT_PREVISTA,\n       A.PREVISAO_ORIGEM,\n       A.DIAS_ATRASO,\n       ROUND(A.IMPACTO, 2)                            AS IMPACTO,\n       A.STATUS_OC,\n       COUNT(*) OVER ()                               AS TOTAL_LINHAS,\n       ROUND(SUM(A.IMPACTO) OVER (), 2)               AS TOTAL_IMPACTO\nFROM atr A\nLEFT JOIN (SELECT\n    P.CODPROD                                                AS CODPROD,\n    P.DESCRPROD                                              AS DESCRPROD,\n    P.REFERENCIA                                             AS REFERENCIA,\n    P.CODVOL                                                 AS UNIDADE,\n    P.MARCA                                                  AS MARCA,\n    P.CODGRUPOPROD                                           AS GRUPO,\n    G.DESCRGRUPOPROD                                         AS GRUPO_DESCR,\n    CASE WHEN P.ATIVO = 'S' THEN 1 ELSE 0 END                AS FL_ATIVO,\n    CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END             AS LEADTIME_PARAM_DIAS,\n    CASE WHEN P.ESTMIN > 0 THEN P.ESTMIN END                 AS ESTOQUE_MIN_PARAM,\n    CAST(NULL AS VARCHAR2(1))                                AS CURVA_ABC,\n    CASE WHEN P.AGRUPMIN > 1 THEN P.AGRUPMIN END             AS MULTIPLO_COMPRA,\n    CASE WHEN P.LOTECOMPMINIMO > 0 THEN P.LOTECOMPMINIMO END AS LOTE_MINIMO,\n    0                                                        AS FL_SOB_ENCOMENDA,\n    CASE WHEN NVL(P.CODPARCCONSIG, 0) > 0 THEN 1 ELSE 0 END  AS FL_CONSIGNADO\nFROM TGFPRO P\nLEFT JOIN TGFGRU G ON G.CODGRUPOPROD = P.CODGRUPOPROD) PD ON PD.CODPROD = A.CODPROD\nORDER BY A.DIAS_ATRASO DESC, A.IMPACTO DESC, A.NUNOTA, A.SEQUENCIA\nFETCH FIRST ? ROWS ONLY","params":["CODEMP","LIMITE_ATRASO"],"tipos":["I","I"]},"Q_SNAP_PROBE":{"sql":"WITH prm AS (\n    SELECT TO_NUMBER(?) AS CODEMP, TO_DATE(?, 'YYYY-MM-DD') AS DT_INI, TO_DATE(?, 'YYYY-MM-DD') AS DT_FIM FROM DUAL\n)\nSELECT TO_CHAR(MIN(S.DATA_SNAPSHOT), 'DD/MM/YYYY') AS PRIMEIRO,\n       TO_CHAR(MAX(S.DATA_SNAPSHOT), 'DD/MM/YYYY') AS ULTIMO,\n       COUNT(*)                                    AS N\nFROM BI_F_SUGESTAO_COMPRA S\nCROSS JOIN prm PR\nWHERE S.DATA_SNAPSHOT >= PR.DT_INI AND S.DATA_SNAPSHOT < PR.DT_FIM + 1\n  AND S.CODEMP = PR.CODEMP","params":["CODEMP","DT_INI","DT_FIM"],"tipos":["I","S","S"]},"Q_ADERENCIA":{"sql":"WITH prm AS (\n    SELECT TO_NUMBER(?) AS CODEMP, TO_DATE(?, 'YYYY-MM-DD') AS DT_INI, TO_DATE(?, 'YYYY-MM-DD') AS DT_FIM,\n           TO_NUMBER(?) AS JANELA\n    FROM DUAL\n),\nsug AS (\n    SELECT S.CODPROD, TO_CHAR(S.DATA_SNAPSHOT, 'YYYY-MM') AS ANO_MES, MIN(TRUNC(S.DATA_SNAPSHOT)) AS DT_ALERTA\n    FROM BI_F_SUGESTAO_COMPRA S\n    CROSS JOIN prm PR\n    WHERE S.QTD_SUGERIDA > 0\n      AND S.DATA_SNAPSHOT >= PR.DT_INI AND S.DATA_SNAPSHOT < PR.DT_FIM + 1\n      AND S.CODEMP = PR.CODEMP\n    GROUP BY S.CODPROD, TO_CHAR(S.DATA_SNAPSHOT, 'YYYY-MM')\n),\nvinc AS (\n    SELECT G.CODPROD, G.ANO_MES, G.DT_ALERTA,\n           (SELECT MIN(O.DT_NEGOCIACAO)\n              FROM (SELECT\n    Z.NUNOTA, Z.SEQUENCIA, Z.CODEMP, Z.CODPARC, Z.FORNECEDOR, Z.CODTIPOPER, Z.DESCRICAO_TOP,\n    Z.CODPROD, Z.OS,\n    Z.QTDNEG * NVL(Z.FATOR, 1)                                       AS QTD_NEGOCIADA,\n    Z.QTDENTREGUE * NVL(Z.FATOR, 1)                                  AS QTD_ENTREGUE,\n    CASE WHEN Z.ABERTA = 1 THEN (Z.QTDNEG - Z.QTDENTREGUE) * NVL(Z.FATOR, 1) ELSE 0 END AS QTD_PENDENTE,\n    CASE WHEN Z.QTDNEG * NVL(Z.FATOR, 1) > 0 THEN Z.VLRTOT / (Z.QTDNEG * NVL(Z.FATOR, 1)) ELSE 0 END AS VLR_UNIT,\n    Z.VLRTOT                                                         AS VLR_TOTAL,\n    Z.DT_NEGOCIACAO,\n    Z.DT_ENTREGA_PREVISTA,\n    Z.PREVISAO_ORIGEM,\n    NVL(Z.DT_LIBERACAO, CASE WHEN Z.STATUSNOTA = 'L' THEN Z.DT_NEGOCIACAO END) AS DT_APROVACAO,\n    Z.DT_ENTREGA_REAL,\n    CASE WHEN Z.CANCELADO = 'S'                              THEN 'CANCELADA'\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG     THEN 'ENTREGUE'\n         WHEN Z.PENDENTE = 'N' AND Z.QTDENTREGUE > 0         THEN 'ENCERRADA_PARCIAL'\n         WHEN Z.PENDENTE = 'N'                               THEN 'ENCERRADA_SEM_RECEBER'\n         WHEN Z.QTDENTREGUE > 0                              THEN 'ENTREGA_PARCIAL'\n         WHEN Z.STATUSNOTA = 'L'                             THEN 'APROVADA_NAO_ENTREGUE'\n         ELSE 'ABERTA_NAO_APROVADA'\n    END                                                              AS STATUS_OC,\n    CASE WHEN Z.ABERTA = 1 AND Z.DT_ENTREGA_PREVISTA < TRUNC(SYSDATE)\n              THEN TRUNC(SYSDATE) - Z.DT_ENTREGA_PREVISTA\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG\n              AND Z.DT_ENTREGA_REAL IS NOT NULL AND Z.DT_ENTREGA_PREVISTA IS NOT NULL\n              THEN Z.DT_ENTREGA_REAL - Z.DT_ENTREGA_PREVISTA\n         ELSE 0\n    END                                                              AS DIAS_ATRASO,\n    CASE WHEN Z.FATOR IS NULL THEN 1 ELSE 0 END                      AS FL_SEM_CONVERSAO\nFROM (\n    SELECT Y.*,\n        CASE WHEN Y.CANCELADO <> 'S' AND Y.PENDENTE = 'S' AND Y.QTDENTREGUE < Y.QTDNEG THEN 1 ELSE 0 END AS ABERTA,\n        CASE WHEN Y.QTDENTREGUE > 0 THEN COALESCE(\n            (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFVAR V JOIN TGFCAB N ON N.NUNOTA = V.NUNOTA\n              WHERE V.NUNOTAORIG = Y.NUNOTA AND V.SEQUENCIAORIG = Y.SEQUENCIA AND V.NUNOTA <> Y.NUNOTA),\n            CASE WHEN Y.OS IS NOT NULL THEN\n                (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFITE E JOIN TGFCAB N ON N.NUNOTA = E.NUNOTA\n                  WHERE N.CODTIPOPER IN (259, 200) AND N.STATUSNOTA = 'L'\n                    AND TRIM(E.AD_OS) = Y.OS AND E.CODPROD = Y.CODPROD\n                    AND N.DTNEG >= Y.DT_NEGOCIACAO - 365)\n            END)\n        END AS DT_ENTREGA_REAL\n    FROM (\n        SELECT\n            C.NUNOTA, I.SEQUENCIA, C.CODEMP, C.CODPARC, PA.NOMEPARC AS FORNECEDOR,\n            C.CODTIPOPER, T.DESCROPER AS DESCRICAO_TOP, I.CODPROD,\n            TRIM(C.AD_OSTUICIAL)                     AS OS,\n            C.STATUSNOTA, NVL(I.PENDENTE, 'S')       AS PENDENTE, NVL(I.CANCELADO, 'N') AS CANCELADO,\n            NVL(I.QTDNEG, 0)                         AS QTDNEG,\n            NVL(I.QTDENTREGUE, 0)                    AS QTDENTREGUE,\n            NVL(I.VLRTOT, 0)                         AS VLRTOT,\n            TRUNC(C.DTNEG)                           AS DT_NEGOCIACAO,\n            COALESCE(TRUNC(C.DTPREVENT), TRUNC(C.DTNEG) + CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END) AS DT_ENTREGA_PREVISTA,\n            CASE WHEN C.DTPREVENT IS NOT NULL THEN 'DTPREVENT'\n                 WHEN P.LEADTIME > 0 THEN 'OC+LEADTIME' END AS PREVISAO_ORIGEM,\n            (SELECT TRUNC(MAX(L.DHLIB)) FROM TSILIB L\n              WHERE L.TABELA = 'TGFCAB' AND L.NUCHAVE = C.NUNOTA\n                AND L.DHLIB IS NOT NULL AND NVL(L.REPROVADO, 'N') <> 'S') AS DT_LIBERACAO,\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END                                      AS FATOR\n        FROM TGFCAB C\n        JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'ORDEM_COMPRA'\n        JOIN TGFTOP T ON T.CODTIPOPER = C.CODTIPOPER AND T.DHALTER = C.DHTIPOPER\n        JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n        JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n        LEFT JOIN TGFPAR PA ON PA.CODPARC = C.CODPARC\n        LEFT JOIN (\n            SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n                   COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n            FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n        ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n        WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -24)\n    ) Y\n) Z) O CROSS JOIN prm PR2\n             WHERE O.CODPROD = G.CODPROD\n               AND O.STATUS_OC <> 'CANCELADA'\n               AND O.DT_NEGOCIACAO >= G.DT_ALERTA\n               AND O.DT_NEGOCIACAO <= G.DT_ALERTA + PR2.JANELA\n               AND (PR2.CODEMP = 0 OR O.CODEMP = PR2.CODEMP)) AS DT_OC\n    FROM sug G\n)\nSELECT COUNT(*)                                            AS SUGESTOES,\n       SUM(CASE WHEN V.DT_OC IS NOT NULL THEN 1 ELSE 0 END) AS ATENDIDAS,\n       ROUND(AVG(V.DT_OC - V.DT_ALERTA), 1)                AS SLA_MEDIO,\n       MEDIAN(V.DT_OC - V.DT_ALERTA)                       AS SLA_MEDIANA\nFROM vinc V","params":["CODEMP","DT_INI","DT_FIM","JANELA_VINCULO_DIAS"],"tipos":["I","S","S","I"]},"Q_CONSUMO":{"sql":"WITH prm AS (\n    SELECT\n        TO_NUMBER(?)          AS CODEMP,\n        TO_NUMBER(?) / 10000  AS DIAS_MES,\n        TO_NUMBER(?)          AS MARGEM,\n        TO_NUMBER(?)          AS COB_MAX,\n        TO_NUMBER(?) / 10000  AS SEG_FRAC,\n        TO_NUMBER(?)          AS COB_A,\n        TO_NUMBER(?)          AS COB_B,\n        TO_NUMBER(?)          AS COB_C,\n        TO_NUMBER(?)          AS LT_PADRAO,\n        TO_NUMBER(?)          AS MEDIA_MODO,\n        TO_NUMBER(?)          AS MESES_MEDIA,\n        TO_NUMBER(?)          AS DIVISOR_MEDIA,\n        TO_NUMBER(?)          AS INCLUI_MES_ATUAL\n    FROM DUAL\n), jan AS (\n    SELECT\n        CASE WHEN PR.INCLUI_MES_ATUAL = 1 THEN TRUNC(SYSDATE, 'MM')\n             ELSE ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -1) END AS FIM,\n        GREATEST(1, PR.MESES_MEDIA) AS NMESES\n    FROM prm PR\n),\njan2 AS (\n    SELECT JA.FIM, JA.NMESES, ADD_MONTHS(JA.FIM, 1 - JA.NMESES) AS INI FROM jan JA\n),\ncons_mes AS (\n    SELECT CM.CODPROD, CM.ANO_MES,\n           SUM(NVL(CM.QTD_VENDA, 0) + NVL(CM.QTD_PERDA, 0) - NVL(CM.QTD_DEVOLUCAO, 0)) AS QTD\n    FROM (SELECT\n    X.CODPROD                                                     AS CODPROD,\n    X.CODEMP                                                      AS CODEMP,\n    X.ANO_MES                                                     AS ANO_MES,\n    SUM(CASE WHEN X.PAPEL = 'CONSUMO'   THEN X.QTD_BASE ELSE 0 END) AS QTD_VENDA,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN X.QTD_BASE ELSE 0 END) AS QTD_DEVOLUCAO,\n    SUM(CASE WHEN X.PAPEL = 'PERDA'     THEN X.QTD_BASE ELSE 0 END) AS QTD_PERDA,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN -X.QTD_BASE ELSE X.QTD_BASE END) AS QTD_CONSUMO,\n    SUM(CASE WHEN X.PAPEL = 'DEVOLUCAO' THEN -X.VLR ELSE X.VLR END)           AS VLR_CONSUMO,\n    SUM(CASE WHEN X.FATOR IS NULL THEN 1 ELSE 0 END)              AS ITENS_SEM_CONVERSAO\nFROM (\n    SELECT\n        I.CODPROD, C.CODEMP, TP.PAPEL,\n        TO_CHAR(C.DTNEG, 'YYYY-MM')                 AS ANO_MES,\n        NVL(I.QTDNEG, 0) * NVL(\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END, 1)                                  AS QTD_BASE,\n        NVL(I.VLRTOT, 0)                             AS VLR,\n        CASE WHEN I.CODVOL = P.CODVOL THEN 1\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n        END                                          AS FATOR\n    FROM TGFCAB C\n    JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL IN ('CONSUMO', 'DEVOLUCAO', 'PERDA')\n    JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n    JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n    LEFT JOIN (\n        SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n               COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n        FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n    ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n    WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -36)\n      AND C.STATUSNOTA = 'L'\n) X\nGROUP BY X.CODPROD, X.CODEMP, X.ANO_MES) CM\n    CROSS JOIN prm PR\n    CROSS JOIN jan2 J\n    WHERE CM.ANO_MES >= TO_CHAR(J.INI, 'YYYY-MM')\n      AND CM.ANO_MES <= TO_CHAR(J.FIM, 'YYYY-MM')\n      AND (PR.CODEMP = 0 OR CM.CODEMP = PR.CODEMP)\n    GROUP BY CM.CODPROD, CM.ANO_MES\n),\ndvs AS (\n    SELECT\n        CASE WHEN PR.DIVISOR_MEDIA > 0 THEN PR.DIVISOR_MEDIA\n             ELSE (SELECT GREATEST(1, COUNT(DISTINCT XM.ANO_MES)) FROM cons_mes XM) END AS DIVISOR,\n        CASE WHEN PR.DIVISOR_MEDIA > 0 THEN 'PARAMETRO' ELSE 'MESES_COM_DADOS' END AS ORIGEM_DIVISOR\n    FROM prm PR\n),\ncons AS (\n    SELECT CS.CODPROD,\n           SUM(CS.QTD) AS QTD_JANELA,\n           SUM(CASE WHEN CS.ANO_MES >= TO_CHAR(ADD_MONTHS(J.FIM, -2), 'YYYY-MM') THEN CS.QTD ELSE 0 END) AS QTD_3M,\n           SUM(CASE WHEN CS.ANO_MES >= TO_CHAR(ADD_MONTHS(J.FIM, -5), 'YYYY-MM') THEN CS.QTD ELSE 0 END) AS QTD_6M\n    FROM cons_mes CS\n    CROSS JOIN jan2 J\n    GROUP BY CS.CODPROD\n),\nest AS (\n    SELECT ES0.CODPROD, SUM(NVL(ES0.QTD_ESTOQUE, 0)) AS QTD\n    FROM (SELECT\n    E.CODPROD                         AS CODPROD,\n    E.CODEMP                          AS CODEMP,\n    SUM(NVL(E.ESTOQUE, 0))            AS QTD_ESTOQUE,\n    SUM(NVL(E.RESERVADO, 0))          AS QTD_RESERVADO,\n    SUM(NVL(E.WMSBLOQUEADO, 0))       AS QTD_BLOQUEADO\nFROM TGFEST E\nWHERE E.CODLOCAL NOT IN (1030000, 2030000)\nGROUP BY E.CODPROD, E.CODEMP) ES0\n    CROSS JOIN prm PR\n    WHERE (PR.CODEMP = 0 OR ES0.CODEMP = PR.CODEMP)\n    GROUP BY ES0.CODPROD\n),\nemp AS (\n    SELECT EM0.CODPROD, SUM(NVL(EM0.QTD_EMPENHADA, 0)) AS QTD\n    FROM (SELECT\n    X.CODPROD                                     AS CODPROD,\n    X.CODEMP                                      AS CODEMP,\n    SUM(X.QTD_ABERTA * NVL(X.FATOR, 1))           AS QTD_EMPENHADA,\n    SUM(X.QTD_ABERTA * X.VLRUNIT)                 AS VLR_EMPENHADO,\n    SUM(CASE WHEN X.FATOR IS NULL THEN 1 ELSE 0 END) AS ITENS_SEM_CONVERSAO\nFROM (\n    SELECT\n        I.CODPROD, C.CODEMP, NVL(I.VLRUNIT, 0) AS VLRUNIT,\n        GREATEST(NVL(I.QTDNEG, 0) - NVL(I.QTDENTREGUE, 0) - NVL(I.QTDCONFERIDA, 0), 0) AS QTD_ABERTA,\n        CASE WHEN I.CODVOL = P.CODVOL THEN 1\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n             WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n        END AS FATOR\n    FROM TGFCAB C\n    JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'EMPENHO'\n    JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n    JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n    LEFT JOIN (\n        SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n               COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n        FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n    ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n    WHERE I.PENDENTE = 'S'\n      AND NVL(I.CANCELADO, 'N') <> 'S'\n) X\nWHERE X.QTD_ABERTA > 0\nGROUP BY X.CODPROD, X.CODEMP) EM0\n    CROSS JOIN prm PR\n    WHERE (PR.CODEMP = 0 OR EM0.CODEMP = PR.CODEMP)\n    GROUP BY EM0.CODPROD\n),\nocx AS (\n    SELECT OX.CODPROD, OX.NUNOTA, OX.SEQUENCIA, OX.CODEMP, OX.STATUS_OC, OX.QTD_PENDENTE,\n           OX.VLR_UNIT, OX.DT_NEGOCIACAO\n    FROM (SELECT\n    Z.NUNOTA, Z.SEQUENCIA, Z.CODEMP, Z.CODPARC, Z.FORNECEDOR, Z.CODTIPOPER, Z.DESCRICAO_TOP,\n    Z.CODPROD, Z.OS,\n    Z.QTDNEG * NVL(Z.FATOR, 1)                                       AS QTD_NEGOCIADA,\n    Z.QTDENTREGUE * NVL(Z.FATOR, 1)                                  AS QTD_ENTREGUE,\n    CASE WHEN Z.ABERTA = 1 THEN (Z.QTDNEG - Z.QTDENTREGUE) * NVL(Z.FATOR, 1) ELSE 0 END AS QTD_PENDENTE,\n    CASE WHEN Z.QTDNEG * NVL(Z.FATOR, 1) > 0 THEN Z.VLRTOT / (Z.QTDNEG * NVL(Z.FATOR, 1)) ELSE 0 END AS VLR_UNIT,\n    Z.VLRTOT                                                         AS VLR_TOTAL,\n    Z.DT_NEGOCIACAO,\n    Z.DT_ENTREGA_PREVISTA,\n    Z.PREVISAO_ORIGEM,\n    NVL(Z.DT_LIBERACAO, CASE WHEN Z.STATUSNOTA = 'L' THEN Z.DT_NEGOCIACAO END) AS DT_APROVACAO,\n    Z.DT_ENTREGA_REAL,\n    CASE WHEN Z.CANCELADO = 'S'                              THEN 'CANCELADA'\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG     THEN 'ENTREGUE'\n         WHEN Z.PENDENTE = 'N' AND Z.QTDENTREGUE > 0         THEN 'ENCERRADA_PARCIAL'\n         WHEN Z.PENDENTE = 'N'                               THEN 'ENCERRADA_SEM_RECEBER'\n         WHEN Z.QTDENTREGUE > 0                              THEN 'ENTREGA_PARCIAL'\n         WHEN Z.STATUSNOTA = 'L'                             THEN 'APROVADA_NAO_ENTREGUE'\n         ELSE 'ABERTA_NAO_APROVADA'\n    END                                                              AS STATUS_OC,\n    CASE WHEN Z.ABERTA = 1 AND Z.DT_ENTREGA_PREVISTA < TRUNC(SYSDATE)\n              THEN TRUNC(SYSDATE) - Z.DT_ENTREGA_PREVISTA\n         WHEN Z.QTDNEG > 0 AND Z.QTDENTREGUE >= Z.QTDNEG\n              AND Z.DT_ENTREGA_REAL IS NOT NULL AND Z.DT_ENTREGA_PREVISTA IS NOT NULL\n              THEN Z.DT_ENTREGA_REAL - Z.DT_ENTREGA_PREVISTA\n         ELSE 0\n    END                                                              AS DIAS_ATRASO,\n    CASE WHEN Z.FATOR IS NULL THEN 1 ELSE 0 END                      AS FL_SEM_CONVERSAO\nFROM (\n    SELECT Y.*,\n        CASE WHEN Y.CANCELADO <> 'S' AND Y.PENDENTE = 'S' AND Y.QTDENTREGUE < Y.QTDNEG THEN 1 ELSE 0 END AS ABERTA,\n        CASE WHEN Y.QTDENTREGUE > 0 THEN COALESCE(\n            (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFVAR V JOIN TGFCAB N ON N.NUNOTA = V.NUNOTA\n              WHERE V.NUNOTAORIG = Y.NUNOTA AND V.SEQUENCIAORIG = Y.SEQUENCIA AND V.NUNOTA <> Y.NUNOTA),\n            CASE WHEN Y.OS IS NOT NULL THEN\n                (SELECT TRUNC(MAX(N.DTNEG)) FROM TGFITE E JOIN TGFCAB N ON N.NUNOTA = E.NUNOTA\n                  WHERE N.CODTIPOPER IN (259, 200) AND N.STATUSNOTA = 'L'\n                    AND TRIM(E.AD_OS) = Y.OS AND E.CODPROD = Y.CODPROD\n                    AND N.DTNEG >= Y.DT_NEGOCIACAO - 365)\n            END)\n        END AS DT_ENTREGA_REAL\n    FROM (\n        SELECT\n            C.NUNOTA, I.SEQUENCIA, C.CODEMP, C.CODPARC, PA.NOMEPARC AS FORNECEDOR,\n            C.CODTIPOPER, T.DESCROPER AS DESCRICAO_TOP, I.CODPROD,\n            TRIM(C.AD_OSTUICIAL)                     AS OS,\n            C.STATUSNOTA, NVL(I.PENDENTE, 'S')       AS PENDENTE, NVL(I.CANCELADO, 'N') AS CANCELADO,\n            NVL(I.QTDNEG, 0)                         AS QTDNEG,\n            NVL(I.QTDENTREGUE, 0)                    AS QTDENTREGUE,\n            NVL(I.VLRTOT, 0)                         AS VLRTOT,\n            TRUNC(C.DTNEG)                           AS DT_NEGOCIACAO,\n            COALESCE(TRUNC(C.DTPREVENT), TRUNC(C.DTNEG) + CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END) AS DT_ENTREGA_PREVISTA,\n            CASE WHEN C.DTPREVENT IS NOT NULL THEN 'DTPREVENT'\n                 WHEN P.LEADTIME > 0 THEN 'OC+LEADTIME' END AS PREVISAO_ORIGEM,\n            (SELECT TRUNC(MAX(L.DHLIB)) FROM TSILIB L\n              WHERE L.TABELA = 'TGFCAB' AND L.NUCHAVE = C.NUNOTA\n                AND L.DHLIB IS NOT NULL AND NVL(L.REPROVADO, 'N') <> 'S') AS DT_LIBERACAO,\n            CASE WHEN I.CODVOL = P.CODVOL THEN 1\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'M' AND VO.QTD_CONV > 0 THEN VO.QTD_CONV\n                 WHEN VO.N_REGRAS = 1 AND VO.DM = 'D' AND VO.QTD_CONV > 0 THEN 1 / VO.QTD_CONV\n            END                                      AS FATOR\n        FROM TGFCAB C\n        JOIN (SELECT 99 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 100 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1741 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 101 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 108 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1742 AS CODTIPOPER, 'ORDEM_COMPRA' AS PAPEL FROM DUAL UNION ALL SELECT 1000 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1005 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1008 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1002 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1009 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1001 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1728 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1010 AS CODTIPOPER, 'EMPENHO' AS PAPEL FROM DUAL UNION ALL SELECT 1131 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1118 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1117 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1729 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1130 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1727 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1724 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1730 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1781 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1782 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1738 AS CODTIPOPER, 'CONSUMO' AS PAPEL FROM DUAL UNION ALL SELECT 1200 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1201 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1211 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL UNION ALL SELECT 1206 AS CODTIPOPER, 'DEVOLUCAO' AS PAPEL FROM DUAL) TP ON TP.CODTIPOPER = C.CODTIPOPER AND TP.PAPEL = 'ORDEM_COMPRA'\n        JOIN TGFTOP T ON T.CODTIPOPER = C.CODTIPOPER AND T.DHALTER = C.DHTIPOPER\n        JOIN TGFITE I ON I.NUNOTA = C.NUNOTA\n        JOIN TGFPRO P ON P.CODPROD = I.CODPROD\n        LEFT JOIN TGFPAR PA ON PA.CODPARC = C.CODPARC\n        LEFT JOIN (\n            SELECT CODPROD, CODVOL, MAX(DIVIDEMULTIPLICA) AS DM, MAX(QUANTIDADE) AS QTD_CONV,\n                   COUNT(DISTINCT DIVIDEMULTIPLICA || '|' || QUANTIDADE) AS N_REGRAS\n            FROM TGFVOA WHERE NVL(ATIVO, 'S') = 'S' GROUP BY CODPROD, CODVOL\n        ) VO ON VO.CODPROD = I.CODPROD AND VO.CODVOL = I.CODVOL\n        WHERE C.DTNEG >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -24)\n    ) Y\n) Z) OX\n),\nocab AS (\n    SELECT OA0.CODPROD, SUM(OA0.QTD_PENDENTE) AS QTD, COUNT(DISTINCT OA0.NUNOTA) AS N_OCS\n    FROM ocx OA0\n    CROSS JOIN prm PR\n    WHERE OA0.STATUS_OC IN ('ABERTA_NAO_APROVADA', 'APROVADA_NAO_ENTREGUE', 'ENTREGA_PARCIAL')\n      AND OA0.QTD_PENDENTE > 0\n      AND (PR.CODEMP = 0 OR OA0.CODEMP = PR.CODEMP)\n    GROUP BY OA0.CODPROD\n),\ncusto AS (\n    SELECT CU0.CODPROD, CU0.VLR_UNIT\n    FROM (\n        SELECT CX.CODPROD, CX.VLR_UNIT,\n               ROW_NUMBER() OVER (PARTITION BY CX.CODPROD\n                                  ORDER BY CX.DT_NEGOCIACAO DESC, CX.NUNOTA DESC, CX.SEQUENCIA DESC) AS RN\n        FROM ocx CX\n        WHERE CX.VLR_UNIT > 0 AND CX.STATUS_OC <> 'CANCELADA'\n    ) CU0\n    WHERE CU0.RN = 1\n),\nbase AS (\n    SELECT\n        PD.CODPROD, PD.DESCRPROD, PD.UNIDADE, PD.GRUPO, PD.GRUPO_DESCR, PD.CURVA_ABC,\n        PD.MULTIPLO_COMPRA, PD.LOTE_MINIMO, PD.ESTOQUE_MIN_PARAM,\n        NVL(PD.FL_SOB_ENCOMENDA, 0) AS FL_SOB_ENCOMENDA,\n        NVL(PD.FL_CONSIGNADO, 0) AS FL_CONSIGNADO,\n        NVL(ES.QTD, 0) AS QTD_ESTOQUE,\n        NVL(EM.QTD, 0) AS QTD_EMPENHADA,\n        NVL(ES.QTD, 0) - NVL(EM.QTD, 0) AS QTD_DISPONIVEL,\n        NVL(OA.QTD, 0) AS QTD_PENDENTE,\n        NVL(OA.N_OCS, 0) AS N_OCS_ABERTAS,\n        NVL(CU.VLR_UNIT, 0) AS VLR_UNIT,\n        CASE WHEN PD.LEADTIME_PARAM_DIAS > 0 THEN PD.LEADTIME_PARAM_DIAS ELSE PR.LT_PADRAO END AS LEADTIME,\n        CASE WHEN PD.LEADTIME_PARAM_DIAS > 0 THEN 0 ELSE 1 END AS FL_LT_PADRAO,\n        NVL(CO.QTD_JANELA, 0) AS QTD_JANELA,\n        NVL(CO.QTD_3M, 0) AS QTD_3M,\n        GREATEST(0, NVL(CO.QTD_JANELA, 0) / DV.DIVISOR) AS MEDIA_SIMPLES,\n        GREATEST(0, 0.5 * NVL(CO.QTD_3M, 0) / 3 + 0.3 * NVL(CO.QTD_6M, 0) / 6\n                    + 0.2 * NVL(CO.QTD_JANELA, 0) / DV.DIVISOR) AS MEDIA_PONDERADA,\n        CASE UPPER(NVL(PD.CURVA_ABC, 'C')) WHEN 'A' THEN PR.COB_A WHEN 'B' THEN PR.COB_B ELSE PR.COB_C END AS COB_ALVO,\n        PR.MEDIA_MODO, PR.DIAS_MES, PR.MARGEM, PR.COB_MAX, PR.SEG_FRAC\n    FROM (SELECT\n    P.CODPROD                                                AS CODPROD,\n    P.DESCRPROD                                              AS DESCRPROD,\n    P.REFERENCIA                                             AS REFERENCIA,\n    P.CODVOL                                                 AS UNIDADE,\n    P.MARCA                                                  AS MARCA,\n    P.CODGRUPOPROD                                           AS GRUPO,\n    G.DESCRGRUPOPROD                                         AS GRUPO_DESCR,\n    CASE WHEN P.ATIVO = 'S' THEN 1 ELSE 0 END                AS FL_ATIVO,\n    CASE WHEN P.LEADTIME > 0 THEN P.LEADTIME END             AS LEADTIME_PARAM_DIAS,\n    CASE WHEN P.ESTMIN > 0 THEN P.ESTMIN END                 AS ESTOQUE_MIN_PARAM,\n    CAST(NULL AS VARCHAR2(1))                                AS CURVA_ABC,\n    CASE WHEN P.AGRUPMIN > 1 THEN P.AGRUPMIN END             AS MULTIPLO_COMPRA,\n    CASE WHEN P.LOTECOMPMINIMO > 0 THEN P.LOTECOMPMINIMO END AS LOTE_MINIMO,\n    0                                                        AS FL_SOB_ENCOMENDA,\n    CASE WHEN NVL(P.CODPARCCONSIG, 0) > 0 THEN 1 ELSE 0 END  AS FL_CONSIGNADO\nFROM TGFPRO P\nLEFT JOIN TGFGRU G ON G.CODGRUPOPROD = P.CODGRUPOPROD) PD\n    CROSS JOIN prm PR\n    CROSS JOIN dvs DV\n    LEFT JOIN est ES ON ES.CODPROD = PD.CODPROD\n    LEFT JOIN emp EM ON EM.CODPROD = PD.CODPROD\n    LEFT JOIN ocab OA ON OA.CODPROD = PD.CODPROD\n    LEFT JOIN custo CU ON CU.CODPROD = PD.CODPROD\n    LEFT JOIN cons CO ON CO.CODPROD = PD.CODPROD\n    WHERE PD.FL_ATIVO = 1\n),\nmed AS (\n    SELECT BA.*,\n           CASE WHEN BA.MEDIA_MODO = 1 THEN BA.MEDIA_PONDERADA ELSE BA.MEDIA_SIMPLES END AS MEDIA_USADA\n    FROM base BA\n),\ndem AS (\n    SELECT ME.*, ME.MEDIA_USADA / ME.DIAS_MES AS DEMANDA_DIARIA FROM med ME\n),\ncob AS (\n    SELECT DE.*,\n        CASE WHEN DE.DEMANDA_DIARIA > 0 THEN DE.QTD_DISPONIVEL / DE.DEMANDA_DIARIA ELSE 999 END AS DIAS_EST_ATUAL,\n        CASE WHEN DE.DEMANDA_DIARIA > 0 THEN (DE.QTD_DISPONIVEL + DE.QTD_PENDENTE) / DE.DEMANDA_DIARIA ELSE 999 END AS DIAS_EST,\n        DE.DEMANDA_DIARIA * DE.LEADTIME * (1 + DE.SEG_FRAC) AS EST_MIN_CALC,\n        CASE WHEN DE.QTD_DISPONIVEL < 0 THEN -DE.QTD_DISPONIVEL * DE.VLR_UNIT ELSE 0 END AS RUPTURA_VALOR,\n        CASE WHEN DE.FL_SOB_ENCOMENDA = 1 OR DE.FL_CONSIGNADO = 1 OR DE.QTD_JANELA <= 0 THEN 0\n             ELSE GREATEST(0, DE.DEMANDA_DIARIA * (DE.LEADTIME + DE.COB_ALVO)\n                              - (DE.QTD_DISPONIVEL + DE.QTD_PENDENTE)) END AS QTD_BRUTA\n    FROM dem DE\n),\nmult AS (\n    SELECT CB.*,\n        CASE WHEN CB.QTD_BRUTA <= 0 THEN 0\n             WHEN NVL(CB.MULTIPLO_COMPRA, 0) > 0 THEN CEIL(CB.QTD_BRUTA / CB.MULTIPLO_COMPRA) * CB.MULTIPLO_COMPRA\n             ELSE CEIL(CB.QTD_BRUTA) END AS QTD_MULT\n    FROM cob CB\n),\nsop AS (\n    SELECT MU.*,\n        CASE WHEN MU.QTD_MULT > 0 AND NVL(MU.LOTE_MINIMO, 0) > MU.QTD_MULT\n             THEN CASE WHEN NVL(MU.MULTIPLO_COMPRA, 0) > 0\n                       THEN CEIL(MU.LOTE_MINIMO / MU.MULTIPLO_COMPRA) * MU.MULTIPLO_COMPRA\n                       ELSE MU.LOTE_MINIMO END\n             ELSE MU.QTD_MULT END AS QTD_SUGERIDA,\n        CASE WHEN MU.QTD_DISPONIVEL < 0 OR (MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST <= 0) THEN 'P1_CRITICO'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME               THEN 'P2_RUPTURA_IMINENTE'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME + MU.MARGEM   THEN 'P3_ATENCAO'\n             WHEN MU.QTD_ESTOQUE > 0 AND MU.QTD_JANELA <= 0                         THEN 'P0_EXCESSO_SEM_GIRO'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST > MU.COB_MAX                THEN 'P0_EXCESSO'\n             ELSE 'OK' END AS PRIORIDADE,\n        CASE WHEN MU.QTD_DISPONIVEL < 0                                             THEN 'RUPTURA'\n             WHEN MU.DEMANDA_DIARIA > 0 AND MU.DIAS_EST < MU.LEADTIME               THEN 'PONTO_PEDIDO'\n             WHEN MU.ESTOQUE_MIN_PARAM > 0 AND MU.QTD_DISPONIVEL < MU.ESTOQUE_MIN_PARAM THEN 'MINIMO_CURVA_A'\n             ELSE 'SEM_DISPARO' END AS REGRA_DISPARO\n    FROM mult MU\n),\ntopn AS (\n    SELECT S.CODPROD, S.DESCRPROD, S.UNIDADE, S.PRIORIDADE, S.MEDIA_USADA, S.MEDIA_SIMPLES,\n           S.MEDIA_PONDERADA, S.QTD_JANELA, S.QTD_3M\n    FROM sop S\n    WHERE S.QTD_JANELA > 0\n    ORDER BY S.QTD_JANELA DESC, S.CODPROD\n    FETCH FIRST ? ROWS ONLY\n)\nSELECT T.CODPROD, T.DESCRPROD, T.UNIDADE, T.PRIORIDADE,\n       ROUND(T.MEDIA_USADA, 2)      AS MEDIA_USADA,\n       ROUND(T.MEDIA_SIMPLES, 2)    AS MEDIA_SIMPLES,\n       ROUND(T.MEDIA_PONDERADA, 2)  AS MEDIA_PONDERADA,\n       ROUND(T.QTD_3M / 3, 2)       AS MEDIA_3M,\n       CASE WHEN T.MEDIA_USADA > 0 THEN ROUND((T.QTD_3M / 3) / T.MEDIA_USADA - 1, 4) END AS DESVIO,\n       ROUND(T.QTD_JANELA, 2)       AS QTD_JANELA,\n       CM.ANO_MES,\n       ROUND(CM.QTD, 2)             AS QTD,\n       TO_CHAR(J.INI, 'YYYY-MM')    AS JANELA_INI_AM,\n       TO_CHAR(J.FIM, 'YYYY-MM')    AS JANELA_FIM_AM,\n       DV.DIVISOR, DV.ORIGEM_DIVISOR\nFROM topn T\nCROSS JOIN jan2 J\nCROSS JOIN dvs DV\nLEFT JOIN cons_mes CM ON CM.CODPROD = T.CODPROD\nORDER BY T.QTD_JANELA DESC, T.CODPROD, CM.ANO_MES","params":["CODEMP","DIAS_MES_X10000","MARGEM_ATENCAO_DIAS","COBERTURA_MAX_DIAS","SEGURANCA_X10000","COBERTURA_ALVO_A","COBERTURA_ALVO_B","COBERTURA_ALVO_C","LEADTIME_DEFAULT","MEDIA_MODO","MESES_MEDIA","DIVISOR_MEDIA","INCLUI_MES_ATUAL","TOPN_CONSUMO"],"tipos":["I","I","I","I","I","I","I","I","I","I","I","I","I","I"]}};

  var ABERTOS = ["ABERTA_NAO_APROVADA", "APROVADA_NAO_ENTREGUE", "ENTREGA_PARCIAL"];
  var PADRAO = {
    DIAS_MES: 30, MARGEM_ATENCAO_DIAS: 15, COBERTURA_MAX_DIAS: 90, SEGURANCA_PCT_LT: 0.2,
    COBERTURA_ALVO_A: 45, COBERTURA_ALVO_B: 30, COBERTURA_ALVO_C: 21, LEADTIME_DEFAULT: 30,
    MEDIA_MODO: 0, MESES_MEDIA: 12, DIVISOR_MEDIA: 0, INCLUI_MES_ATUAL: 1, JANELA_VINCULO_DIAS: 30
  };
  var DESCR = {
    DIAS_MES: "Divisor mensal \u2192 di\u00e1rio (30 corridos; usar ~21,75 para dias \u00fateis)",
    MARGEM_ATENCAO_DIAS: "Margem da faixa P3 (aten\u00e7\u00e3o) acima do lead time",
    COBERTURA_MAX_DIAS: "Acima disso = P0 excesso",
    SEGURANCA_PCT_LT: "Fra\u00e7\u00e3o da demanda do lead time como seguran\u00e7a (0,20 = 20%)",
    COBERTURA_ALVO_A: "Dias de cobertura alvo, curva A",
    COBERTURA_ALVO_B: "Dias de cobertura alvo, curva B",
    COBERTURA_ALVO_C: "Dias de cobertura alvo, curva C e produto sem curva",
