  /* ---------------- execu\u00e7\u00e3o de consultas ---------------- */
  function valorParam(nome, extra) {
    if (extra && Object.prototype.hasOwnProperty.call(extra, nome)) return extra[nome];
    if (nome === "DIAG_NUM") return 123;
    if (nome === "CODEMP") return est.codemp;
    if (nome === "DT_INI") return est.dtIni;
    if (nome === "DT_FIM") return est.dtFim;
    if (nome === "DIAS_MES_X10000") return Math.round(est.cfg.DIAS_MES * 10000);
    if (nome === "SEGURANCA_X10000") return Math.round(est.cfg.SEGURANCA_PCT_LT * 10000);
    if (Object.prototype.hasOwnProperty.call(LIMITES, nome)) return LIMITES[nome];
    if (Object.prototype.hasOwnProperty.call(est.cfg, nome)) return Math.round(est.cfg[nome]);
    throw new Error("Par\u00e2metro sem valor: " + nome);
  }
  function montarParams(id, extra) {
    var q = Q[id], out = [];
    for (var i = 0; i < q.params.length; i++) {
      var v = String(valorParam(q.params[i], extra)), t = q.tipos[i];
      if (t === "I" && !/^-?\d+$/.test(v)) throw new Error("Par\u00e2metro " + q.params[i] + " inv\u00e1lido: " + v);
      if (t === "S" && !/^\d{4}-\d{2}-\d{2}$/.test(v)) throw new Error("Data inv\u00e1lida em " + q.params[i] + ": " + v);
      out.push({ value: v, type: t });
