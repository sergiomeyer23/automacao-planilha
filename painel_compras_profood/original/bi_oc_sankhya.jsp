    if (!dI || !dF) aviso("info", "Per\u00edodo do Construtor n\u00e3o informado: usando " + (dI ? "a data inicial recebida" : "os \u00faltimos 90 dias") + " at\u00e9 " + (dF ? "a data final recebida" : "hoje") + ".");
    if (est.dtIni > est.dtFim) { var t = est.dtIni; est.dtIni = est.dtFim; est.dtFim = t; aviso("aviso", "Data inicial depois da final: datas invertidas."); }
