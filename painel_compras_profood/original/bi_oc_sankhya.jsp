    if (linhas === null) throw new Error("Formato de retorno do executeQuery n\u00e3o reconhecido. Recebido: " + descreverValor(valor));
    for (var i = 0; i < linhas.length; i++) {
      if (linhas[i] === null || typeof linhas[i] !== "object" || Array.isArray(linhas[i])) {
