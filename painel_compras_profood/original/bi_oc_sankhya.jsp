    if (/ORA-01722/.test(msg)) return "N\u00famero inv\u00e1lido: confira os par\u00e2metros e os tipos enviados.";
    if (/ORA-0184[0-9]|ORA-0186[0-9]|ORA-0183[0-9]/.test(msg)) return "Formato de data recusado pelo banco.";
    if (/ORA-01013|tempo|timeout|Sem resposta/i.test(msg)) return "A consulta demorou demais. Reduza o per\u00edodo ou pe\u00e7a ao DBA para materializar as views.";
