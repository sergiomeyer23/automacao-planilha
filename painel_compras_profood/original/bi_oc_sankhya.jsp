  }

  /* ---------------- leitura do retorno do executeQuery ----------------
     O modelo oficial faz JSON.parse(value) sempre. Aqui aceitamos tamb\u00e9m: texto embrulhado
     (objeto String), JSON codificado duas vezes, lista j\u00e1 pronta, objeto parecido com lista
     e inv\u00f3lucros comuns ({rows}, {data}, {responseBody}...). Se nada servir, a mensagem
     mostra o tipo e o in\u00edcio do que chegou, para diagn\u00f3stico na homologa\u00e7\u00e3o. */
  var formatoVisto = "";
  function descreverValor(v) {
    var tipo = Object.prototype.toString.call(v), txt;
    try { txt = (typeof v === "string") ? v : JSON.stringify(v); } catch (e) { txt = String(v); }
    if (txt === undefined || txt === null) txt = String(v);
    txt = String(txt);
    return tipo + " \u00b7 " + txt.length + " caracteres \u00b7 in\u00edcio: " + txt.slice(0, 300);
  }
  function ehTexto(v) { return typeof v === "string" || Object.prototype.toString.call(v) === "[object String]"; }
  function comoLinhas(v, nivel) {
    if (nivel > 6 || v === null || v === undefined) return null;
    if (ehTexto(v)) {
      var s = String(v).replace(/^\s+|\s+$/g, "");
      if (s === "") return [];
      var p;
      try { p = JSON.parse(s); } catch (e) { return null; }
      return comoLinhas(p, nivel + 1);
    }
    if (Array.isArray(v)) return v;
    if (typeof v === "object") {
      if (typeof v.length === "number" && v.length >= 0 && (v.length === 0 || v[0] !== undefined)) return Array.prototype.slice.call(v);
      /* Como o modelo oficial (JSON.parse(value)): o objeto pode ser um texto Java embrulhado
         cujo toString() devolve o JSON. Visto no Construtor: {"c":{"b":"[{...}]"},"b":null}. */
      var comoTexto = null;
      try { comoTexto = String(v); } catch (e) { comoTexto = null; }
      if (comoTexto && comoTexto !== "[object Object]" && /^\s*[\[{"]/.test(comoTexto)) {
        var viaTexto = comoLinhas(comoTexto, nivel + 1);
        if (viaTexto) return viaTexto;
      }
      var nomes = ["rows", "data", "dados", "result", "resultado", "registros", "lista", "responseBody", "value", "valor"];
      for (var i = 0; i < nomes.length; i++) {
        if (v[nomes[i]] === undefined || v[nomes[i]] === null) continue;
        var dentro = comoLinhas(v[nomes[i]], nivel + 1);
        if (!dentro) continue;
        var campos = v.fields || v.fieldsMetadata || v.columns || v.colunas || v.metadata;
        if (dentro.length && Array.isArray(dentro[0]) && Array.isArray(campos)) {
          return dentro.map(function (r) {
            var o = {};
            for (var k = 0; k < campos.length; k++) {
              var c = campos[k];
              o[typeof c === "string" ? c : (c.name || c.nome || c.label || ("C" + k))] = r[k];
            }
            return o;
          });
        }
        return dentro;
      }
      /* Envelope sem nome conhecido: procura, em qualquer propriedade, um texto JSON com a lista. */
      for (var chave in v) {
        if (!Object.prototype.hasOwnProperty.call(v, chave)) continue;
        var x = v[chave];
        if (x === null || x === undefined || (typeof x !== "object" && !ehTexto(x))) continue;
        var achou = comoLinhas(x, nivel + 1);
        if (achou) return achou;
      }
    }
    return null;
  }
