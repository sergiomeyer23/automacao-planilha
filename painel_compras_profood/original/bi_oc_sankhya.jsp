    });
    return est.hist;
  }

  /* ---------------- gr\u00e1ficos SVG ---------------- */
  function barrasH(itens, larguraRot) {
    var max = 0, i;
    for (i = 0; i < itens.length; i++) if (itens[i].val > max) max = itens[i].val;
    if (!max) max = 1;
    var h = 26, W = 560, L = larguraRot || 170, H = itens.length * h + 6, s;
    s = "<svg viewBox=\"0 0 " + W + " " + H + "\" width=\"100%\" height=\"" + H + "\" role=\"img\">";
    for (i = 0; i < itens.length; i++) {
      var it = itens[i], y = i * h + 4, w = Math.max(1, (W - L - 140) * it.val / max);
      s += "<text x=\"0\" y=\"" + (y + 14) + "\">" + esc(it.rot) + "</text>";
      s += "<rect x=\"" + L + "\" y=\"" + y + "\" width=\"" + w.toFixed(1) + "\" height=\"18\" rx=\"3\" fill=\"" + it.cor + "\"><title>" + esc(it.tip || it.txt) + "</title></rect>";
      s += "<text x=\"" + (L + w + 6).toFixed(1) + "\" y=\"" + (y + 14) + "\">" + esc(it.txt) + "</text>";
    }
    return s + "</svg>";
  }

  /* ================= P\u00c1GINA 1 \u00b7 EXECUTIVA ================= */
