    }
    if (id === "Q_ADERENCIA") return [{ SUGESTOES: 184, ATENDIDAS: 121, SLA_MEDIO: 4.6, SLA_MEDIANA: 3 }];
    if (id === "Q_EXEC") {
      var g = {};
      for (i = 0; i < P.length; i++) {
        var x = P[i], a = g[x.PRIORIDADE] || (g[x.PRIORIDADE] = { PRIORIDADE: x.PRIORIDADE, N_SKUS: 0, RUPTURA: 0, N_RUPTURA: 0, N_SUGERIDOS: 0, NECESSIDADE: 0, N_SEM_CUSTO: 0, N_LT_PADRAO: 0,
          DIVISOR: D.meses.length, ORIGEM_DIVISOR: "MESES_COM_DADOS", JANELA_INI: D.meses[0].slice(5) + "/" + D.meses[0].slice(0, 4),
          JANELA_FIM: D.meses[D.meses.length - 1].slice(5) + "/" + D.meses[D.meses.length - 1].slice(0, 4), SNAPSHOT: snap });
        a.N_SKUS++; a.RUPTURA += x.RUPTURA_VALOR; if (x.RUPTURA_VALOR > 0) a.N_RUPTURA++;
        if (x.QTD_SUGERIDA > 0) { a.N_SUGERIDOS++; a.NECESSIDADE += x.QTD_SUGERIDA * x.VLR_UNIT; if (!x.VLR_UNIT) a.N_SEM_CUSTO++; }
        a.N_LT_PADRAO += x.FL_LT_PADRAO;
      }
      for (var k in g) if (Object.prototype.hasOwnProperty.call(g, k)) out.push(g[k]);
      return out;
    }
    if (id === "Q_TOP15") {
      return P.filter(function (x) { return x.RUPTURA_VALOR > 0; }).sort(function (a, b) { return b.RUPTURA_VALOR - a.RUPTURA_VALOR; }).slice(0, 15);
    }
    if (id === "Q_FILA") {
      out = P.filter(function (x) { return ["P1_CRITICO", "P2_RUPTURA_IMINENTE", "P3_ATENCAO"].indexOf(x.PRIORIDADE) >= 0 || x.QTD_SUGERIDA > 0; })
        .sort(function (a, b) { return ordemPrio(a.PRIORIDADE) - ordemPrio(b.PRIORIDADE) || b.RUPTURA_VALOR - a.RUPTURA_VALOR || a.DIAS_EST - b.DIAS_EST; });
      var lim = parseInt(pv(params, id, "LIMITE_FILA"), 10), tot = out.length;
      return out.slice(0, lim).map(function (x) { var y = {}; for (var kk in x) y[kk] = x[kk]; y.TOTAL_LINHAS = tot; return y; });
    }
    if (id === "Q_NAO_COBRE") {
      out = P.filter(function (x) { return x.QTD_PENDENTE > 0 && x.QTD_SUGERIDA > 0; })
        .sort(function (a, b) { return ordemPrio(a.PRIORIDADE) - ordemPrio(b.PRIORIDADE) || b.VLR_SUGERIDO - a.VLR_SUGERIDO; });
      var tv = soma(out, function (x) { return x.VLR_SUGERIDO; }), ts = out.length;
      return out.slice(0, parseInt(pv(params, id, "LIMITE_NAO_COBRE"), 10)).map(function (x) {
        return { CODPROD: x.CODPROD, DESCRPROD: x.DESCRPROD, UNIDADE: x.UNIDADE, PRIORIDADE: x.PRIORIDADE, QTD_PENDENTE: x.QTD_PENDENTE, QTD_SUGERIDA: x.QTD_SUGERIDA,
          VLR_FALTANTE: x.VLR_SUGERIDO, N_OCS_ABERTAS: x.N_OCS_ABERTAS, TOTAL_SKUS: ts, TOTAL_VLR: tv, N_OCS_ENVOLVIDAS: Math.round(ts * 1.3) };
      });
    }
    var O = D.ocs;
    if (id === "Q_OC_KPIS") {
      var ab = {}, at = {}, tr = 0, en = 0, np = 0;
      O.forEach(function (o) {
        if (ABERTOS.indexOf(o.STATUS_OC) >= 0 && o.QTD_PENDENTE > 0) { ab[o.NUNOTA] = 1; tr += o.QTD_PENDENTE * o.VLR_UNIT; if (o.DIAS_ATRASO > 0) at[o.NUNOTA] = 1; }
        if (o.STATUS_OC === "ENTREGUE" && o.DT_REAL && o.DT_REAL >= ini && o.DT_REAL <= fim) { en++; if (o.DIAS_ATRASO <= 0) np++; }
      });
      return [{ OCS_ABERTAS: Object.keys(ab).length, OCS_ATRASO: Object.keys(at).length, VLR_TRANSITO: Math.round(tr * 100) / 100, ENTREGAS: en,
        ENTREGAS_NO_PRAZO: np, ENTREGUES_SEM_DATA: 0, ABERTAS_SEM_PREVISAO: 0, ABERTAS_PREV_ESTIMADA: 31, ITENS_ABERTOS: 42, SNAPSHOT: snap }];
    }
    if (id === "Q_FUNIL") {
      var gs = {}, todas = {};
      O.forEach(function (o) {
        if (o.DT_NEG < ini || o.DT_NEG > fim) return;
        todas[o.NUNOTA] = 1;
        var a2 = gs[o.STATUS_OC] || (gs[o.STATUS_OC] = { STATUS_OC: o.STATUS_OC, n: {}, N_ITENS: 0, VLR_TOTAL: 0 });
        a2.n[o.NUNOTA] = 1; a2.N_ITENS++; a2.VLR_TOTAL += o.VLR_TOTAL;
      });
      for (var s in gs) if (Object.prototype.hasOwnProperty.call(gs, s)) out.push({ STATUS_OC: s, N_OCS: Object.keys(gs[s].n).length, N_ITENS: gs[s].N_ITENS, VLR_TOTAL: gs[s].VLR_TOTAL, N_OCS_PERIODO: Object.keys(todas).length });
      return out;
    }
    if (id === "Q_AGING") {
      var fx = [null, { ORDEM: 1, FAIXA: "0-15", n: {}, N_ITENS: 0, VLR_PENDENTE: 0 }, { ORDEM: 2, FAIXA: "16-30", n: {}, N_ITENS: 0, VLR_PENDENTE: 0 },
        { ORDEM: 3, FAIXA: "31-60", n: {}, N_ITENS: 0, VLR_PENDENTE: 0 }, { ORDEM: 4, FAIXA: "60+", n: {}, N_ITENS: 0, VLR_PENDENTE: 0 }];
      O.forEach(function (o) {
        if (ABERTOS.indexOf(o.STATUS_OC) < 0 || o.QTD_PENDENTE <= 0) return;
        var idade = Math.round((agora - o.DT_NEG) / 864e5), f = idade <= 15 ? 1 : idade <= 30 ? 2 : idade <= 60 ? 3 : 4;
        fx[f].n[o.NUNOTA] = 1; fx[f].N_ITENS++; fx[f].VLR_PENDENTE += o.QTD_PENDENTE * o.VLR_UNIT;
      });
      for (i = 1; i <= 4; i++) if (fx[i].N_ITENS) out.push({ ORDEM: i, FAIXA: fx[i].FAIXA, N_OCS: Object.keys(fx[i].n).length, N_ITENS: fx[i].N_ITENS, VLR_PENDENTE: fx[i].VLR_PENDENTE });
      return out;
    }
    if (id === "Q_ATRASO") {
      out = O.filter(function (o) { return ABERTOS.indexOf(o.STATUS_OC) >= 0 && o.QTD_PENDENTE > 0 && o.DIAS_ATRASO > 0; })
        .sort(function (a, b) { return b.DIAS_ATRASO - a.DIAS_ATRASO; });
      var ti = soma(out, function (o) { return o.QTD_PENDENTE * o.VLR_UNIT; }), tl = out.length;
      return out.slice(0, parseInt(pv(params, id, "LIMITE_ATRASO"), 10)).map(function (o) {
        return { NUNOTA: o.NUNOTA, SEQUENCIA: o.SEQUENCIA, CODPROD: o.CODPROD, DESCRPROD: o.DESCRPROD, UNIDADE: o.UNIDADE, FORNECEDOR: o.FORNECEDOR,
          QTD_PENDENTE: o.QTD_PENDENTE, DT_PREVISTA: dataBR(o.DT_PREV), PREVISAO_ORIGEM: o.NUNOTA % 4 ? "OC+LEADTIME" : "DTPREVENT", DIAS_ATRASO: o.DIAS_ATRASO, IMPACTO: Math.round(o.QTD_PENDENTE * o.VLR_UNIT * 100) / 100,
          STATUS_OC: o.STATUS_OC, TOTAL_LINHAS: tl, TOTAL_IMPACTO: ti };
      });
    }
    if (id === "Q_CONSUMO") {
      var topn = parseInt(pv(params, id, "TOPN_CONSUMO"), 10);
      var top = P.filter(function (x) { return x._tot > 0; }).sort(function (a, b) { return b._tot - a._tot; }).slice(0, topn);
      top.forEach(function (x) {
        D.meses.forEach(function (m) {
          if (!x._cons[m]) return;
          out.push({ CODPROD: x.CODPROD, DESCRPROD: x.DESCRPROD, UNIDADE: x.UNIDADE, PRIORIDADE: x.PRIORIDADE, MEDIA_USADA: x.MEDIA_USADA,
            MEDIA_SIMPLES: x.MEDIA_SIMPLES, MEDIA_PONDERADA: x.MEDIA_PONDERADA, MEDIA_3M: x.MEDIA_3M, DESVIO: x.DESVIO, QTD_JANELA: x._tot,
            ANO_MES: m, QTD: x._cons[m], JANELA_INI_AM: D.meses[0], JANELA_FIM_AM: D.meses[D.meses.length - 1], DIVISOR: D.meses.length, ORIGEM_DIVISOR: "MESES_COM_DADOS" });
        });
      });
      return out;
    }
    return new Error("Consulta sem dados de demonstra\u00e7\u00e3o: " + id);
  }

  /* ---------------- in\u00edcio ---------------- */
  function bloquear(html) {
    var secs = document.querySelectorAll("section.pg");
    for (var i = 0; i < secs.length; i++) secs[i].hidden = true;
    $("abas").hidden = true;
    $("bloqueio").innerHTML = html;
    $("bloqueio").hidden = false;
  }
  function iniciar() {
    est.demo = /(^|[?&])modo=demo(&|$)/.test(window.location.search);
    est.demoSnap = /(^|[?&])snapshot=1(&|$)/.test(window.location.search);
    if (!Q) { bloquear("<b>Pacote incompleto:</b> as consultas n\u00e3o foram embutidas pelo build."); return; }
    iniciarFiltros();
    ligar();
    if (est.demo) {
      $("selo-demo").hidden = false;
      aviso("info", "Modo demonstra\u00e7\u00e3o: dados SIMULADOS, gerados no navegador. Nenhuma consulta \u00e9 enviada ao Sankhya." + (est.demoSnap ? " Hist\u00f3rico de snapshot simulado." : " Para simular o hist\u00f3rico, acrescente &snapshot=1 ao endere\u00e7o."));
    } else if (typeof executeQuery !== "function") {
      bloquear("<h2>Abra pelo componente HTML5 do Construtor de BI</h2><p>Esta p\u00e1gina precisa da fun\u00e7\u00e3o <code>executeQuery</code>, que s\u00f3 existe quando o arquivo \u00e9 aberto pelo componente " +
        "\"JavaScript Simples HTML5\" do Construtor de BI do Sankhya.</p><p class=\"nota\">Para ver o layout com dados simulados, abra com <code>?modo=demo</code> no endere\u00e7o.</p>");
      return;
    }
    testarExecuteQuery().then(function () { return carregarParametros(); }).then(function () { abrir("exec"); });
  }
  function testarExecuteQuery() {
    return rodar("Q_DIAG").then(function (l) {
      var r = l[0] || {};
      est.diag = { ok: true, texto: "ok \u00b7 NUMERO=" + r.NUMERO + " \u00b7 DATA=" + r.DATA + " \u00b7 TEXTO=" + r.TEXTO, formato: formatoVisto };
    }, function (e) {
      est.diag = { ok: false, texto: textoErro(e), formato: formatoVisto };
      aviso("alerta", "Teste do executeQuery falhou (SELECT simples em DUAL): " + textoErro(e).slice(0, 600) + " \u00b7 Envie um print desta mensagem.");
    });
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", iniciar);
  else iniciar();
})();
</script>
