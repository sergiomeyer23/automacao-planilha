  function rodar(id, extra) {
    var params;
    try { params = montarParams(id, extra); } catch (e) { return Promise.reject(e); }
    var chave = id + "|" + JSON.stringify(params);
    if (est.cache[chave]) return est.cache[chave];
    var t0 = Date.now();
    var p = new Promise(function (ok, falha) {
      if (est.demo) { demoRodar(id, params, ok, falha); return; }
      var feito = false;
      var timer = setTimeout(function () {
        if (feito) return;
        feito = true;
        falha(new Error("Sem resposta do executeQuery em 180 s."));
      }, 180000);
      try {
        executeQuery(Q[id].sql, params, function (valor) {
          if (feito) return;
          feito = true;
