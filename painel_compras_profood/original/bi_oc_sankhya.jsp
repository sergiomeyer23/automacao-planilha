    var b = $("ff-busca").value.toUpperCase().replace(/^\s+|\s+$/g, "");
    var out = [];
    for (var i = 0; i < est.fila.length; i++) {
      var r = est.fila[i];
      if (p && r.PRIORIDADE !== p) continue;
      if (c && curvaDe(r) !== c) continue;
      if (g && grupoDe(r) !== g) continue;
      if (rg && String(r.REGRA_DISPARO) !== rg) continue;
