    return out.sort();
  }
  function grupoDe(r) { return r.GRUPO_DESCR ? r.GRUPO + " \u00b7 " + r.GRUPO_DESCR : (r.GRUPO === null || r.GRUPO === undefined ? "(sem grupo)" : String(r.GRUPO)); }
