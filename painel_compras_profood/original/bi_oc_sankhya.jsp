    est.cache[chave] = p;
    return p;
  }

  /* ---------------- par\u00e2metros do c\u00e1lculo (BI_PARAM_COMPRA) ---------------- */
  function paramValido(k, v) {
    if (k === "MEDIA_MODO" || k === "INCLUI_MES_ATUAL") return v === 0 || v === 1;
    if (k === "DIVISOR_MEDIA") return v >= 0 && v <= 36 && v === Math.round(v);
    if (k === "MESES_MEDIA") return v >= 1 && v <= 36 && v === Math.round(v);
    if (k === "SEGURANCA_PCT_LT") return v >= 0 && v <= 1;
    if (k === "DIAS_MES") return v > 0 && v <= 31;
    return v >= 0 && v <= 3650 && v === Math.round(v);
  }
  function carregarParametros() {
    var k;
    for (k in PADRAO) if (Object.prototype.hasOwnProperty.call(PADRAO, k)) { est.cfg[k] = PADRAO[k]; est.cfgOrigem[k] = "padr\u00e3o"; }
    return rodar("Q_PARAMS").then(function (linhas) {
      est.cfgTabela = true;
      for (var i = 0; i < linhas.length; i++) {
        var chave = String(linhas[i].CHAVE || "").replace(/^\s+|\s+$/g, "").toUpperCase();
        if (!Object.prototype.hasOwnProperty.call(PADRAO, chave)) continue;
        var v = num(linhas[i].VALOR);
        if (v === null || !paramValido(chave, v)) {
          aviso("aviso", "BI_PARAM_COMPRA." + chave + " = \"" + linhas[i].VALOR + "\" fora da faixa aceita: usado o padr\u00e3o " + PADRAO[chave] + ".");
          continue;
        }
        est.cfg[chave] = v;
        est.cfgOrigem[chave] = "tabela";
      }
      var falt = [];
      for (k in PADRAO) if (est.cfgOrigem[k] === "padr\u00e3o") falt.push(k);
      if (falt.length) aviso("aviso", "BI_PARAM_COMPRA sem valor v\u00e1lido para: " + falt.join(", ") + ". Usados os padr\u00f5es (aba Par\u00e2metros).");
    }, function (e) {
      est.cfgTabela = false;
      est.cfgErro = primeiraLinha(e.message);
      aviso("aviso", "Par\u00e2metros PADR\u00c3O em uso (a tabela opcional BI_PARAM_COMPRA n\u00e3o existe): 30 dias/m\u00eas, seguran\u00e7a 20%, cobertura 45/30/21, margem 15, excesso 90, lead time padr\u00e3o 30. Detalhes na aba Par\u00e2metros e diagn\u00f3stico.");
    });
  }
  function textoMedia() {
    var m = est.media || {};
    return "M\u00e9dia " + (est.cfg.MEDIA_MODO === 1 ? "PONDERADA (0,5\u00b7M3 + 0,3\u00b7M6 + 0,2\u00b7M12)" : "SIMPLES") +
      " \u00b7 janela " + (m.ini || "?") + " a " + (m.fim || "?") + (est.cfg.INCLUI_MES_ATUAL === 1 ? " (m\u00eas atual inclu\u00eddo, parcial)" : "") +
      " \u00b7 divisor " + (m.divisor || "?") + (m.origem === "PARAMETRO" ? " (par\u00e2metro)" : " (meses com dados na janela)") +
      " \u00b7 par\u00e2metros: " + (est.cfgTabela ? "BI_PARAM_COMPRA" : "PADR\u00c3O");
  }

  /* ---------------- hist\u00f3rico (snapshot) ---------------- */
  function historico() {
    if (est.hist) return est.hist;
    est.hist = rodar("Q_SNAP_PROBE").then(function (l) {
      var r = l[0] || {};
      if (!num(r.N)) return { ok: false, motivo: "Sem snapshot no per\u00edodo para " + (est.codemp ? "a empresa " + est.codemp : "o consolidado (CODEMP 0)") + " \u2014 rodar job de snapshot." };
      return rodar("Q_ADERENCIA").then(function (a) {
        var x = a[0] || {};
        return { ok: true, primeiro: r.PRIMEIRO, ultimo: r.ULTIMO, sug: num(x.SUGESTOES), atend: num(x.ATENDIDAS), sla: num(x.SLA_MEDIO), mediana: num(x.SLA_MEDIANA) };
      });
