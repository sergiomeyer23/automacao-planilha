  function normData(v) {
    if (!v) return null;
    var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(v);
    if (m) return m[1] + "-" + m[2] + "-" + m[3];
    m = /^(\d{2})\/(\d{2})\/(\d{4})/.exec(v);
    if (m) return m[3] + "-" + m[2] + "-" + m[1];
    return null;
  }
  function iniciarFiltros() {
    var ini = lerBI("PERIODO_INI"), fim = lerBI("PERIODO_FIN"), emp = lerBI("CODEMP");
    var dI = normData(ini), dF = normData(fim);
    if (ini && !dI) aviso("aviso", "Formato de PERIODO.INI n\u00e3o reconhecido (\"" + ini + "\"). Usado o padr\u00e3o. Registrar no roteiro de homologa\u00e7\u00e3o.");
    if (fim && !dF) aviso("aviso", "Formato de PERIODO.FIN n\u00e3o reconhecido (\"" + fim + "\"). Usado o padr\u00e3o. Registrar no roteiro de homologa\u00e7\u00e3o.");
